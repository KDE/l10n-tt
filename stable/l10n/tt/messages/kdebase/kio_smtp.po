#: command.cc:138
msgid ""
"The server rejected both EHLO and HELO commands as unknown or unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"Server EHLO belän HELO boyırıqların totılmağan yä ki bilgesez itep kire qaqtı.\n"
"Ul server idäräçäsenä endäşep bula."

#: command.cc:152
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"Server yağınnan %1 boyırıqqa kötelmägän cawap kilde.\n"
"%2"

#: command.cc:172
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"Bu SMTP-server TLS protokolın totmí. Serläwsez totaşası kilsä, TLS protokolın "
"sünderep bula."

#: command.cc:186
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"Bu SMTP-server TLS protokolın totqan kebek bulsa da, anıñ aşa aralasıp "
"bulmadı.\n"
"KDE'neñ serläw caylaw modulı aşa TLS qullanuın sünderep bula."

#: command.cc:191
msgid "Connection Failed"
msgstr "Totaşılıp Bulmadı"

#: command.cc:242
msgid "Authentication support is not compiled into kio_smtp."
msgstr "kio_smtp cíılğanda tanıtunı totu östälengän bulmağan."

#: command.cc:271
msgid "No authentication details supplied."
msgstr "Tanıtu beleme birelmäde."

#: command.cc:374
msgid ""
"Your SMTP server does not support %1.\n"
"Choose a different authentication method.\n"
"%2"
msgstr ""
"Bu SMTP-server %1 propokolın totmí.\n"
"Tanılu ısulınıñ başqasın saylap bula.\n"
"%2"

#: command.cc:378
#, c-format
msgid ""
"Your SMTP server does not support authentication.\n"
"  %2"
msgstr ""
"Bu SMTP-server tanılunı totmí.\n"
"  %2"

#: command.cc:382
#, c-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"Tanılu uzmadı.\n"
"Sersüz kileşmi kebek.\n"
"%1"

#: command.cc:520
msgid "Could not read data from application."
msgstr "Yazılımnıñ eş biremen uqıp bulmadı."

#: command.cc:537
#, c-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"Bu belderü eçtälege alınğan bulmadı.\n"
"%1"

#: response.cc:105
#, c-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"Server cawap birde:\n"
"%1"

#: response.cc:108
msgid "The server responded: \"%1\""
msgstr "Server birgän cawap: \"%1\""

#: response.cc:111
msgid "This is a temporary failure. You may try again later."
msgstr "Waqıtlı ütmäw bu. Beraz soñraq sınap qarísı."

#: smtp.cc:188
msgid "The application sent an invalid request."
msgstr "Bu yazılım yaraqsız soraw cibärde."

#: smtp.cc:250
msgid "The sender address is missing."
msgstr "Cibärüçeneñ adrese yuq."

#: smtp.cc:258
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTPProtocol::smtp_open uzmadı (%1)"

#: smtp.cc:266
msgid ""
"Your server does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"Bu server 8-bit bilgeläre belän xäbärlärne totmí.\n"
"Base64 yä quoted-printable bilgelämäsen qullanırğa kiräk."

#: smtp.cc:345
msgid "Invalid SMTP response (%1) received."
msgstr "Yaraqsız SMTP-cawap kilde: %1."

#: smtp.cc:532
#, c-format
msgid ""
"The server did not accept the connection.\n"
"%1"
msgstr ""
"Server bu totaşılunı almadı.\n"
"%1"

#: smtp.cc:607
msgid "Username and password for your SMTP account:"
msgstr "SMTP xísabıña ireşü adı belän sersüz:"

#: transactionstate.cc:53
#, c-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"Server buş yünältü adresen almadı.\n"
"%1"

#: transactionstate.cc:56
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"Server \"%1\" digän yünältü adresen almadı.\n"
"%2"

#: transactionstate.cc:97
#, c-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"Server kiläse aluçılarnı kire qaqqaç, xäbärne cibärep bulmadı:\n"
"%1"

#: transactionstate.cc:107
#, c-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"Xat eçtälegen cibärep qarağanda xata kilep çıqtı.\n"
"%1"

#: transactionstate.cc:111
msgid "Unhandled error condition. Please send a bug report."
msgstr "Totılmağan xata şartı. Xata turında belder zinhar."

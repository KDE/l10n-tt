#: kdesu.cpp:56 kdesu.cpp:57
msgid "Specifies the command to run"
msgstr "Cibäräse boyırıqnı bilgeli"

#: kdesu.cpp:58
msgid "Run command under target uid if <file> is not writable"
msgstr "Boyırıqnı äytelgän uid belän cibäräse, <file> eçenä yazarlıq bulmasa"

#: kdesu.cpp:59
msgid "Specifies the target uid"
msgstr "Yünälmä qullanuçısın bilgeli"

#: kdesu.cpp:60
msgid "Do not keep password"
msgstr "Sersüz saqlamasqa"

#: kdesu.cpp:61
msgid "Stop the daemon (forgets all passwords)"
msgstr "Xezmätne tuqtat (bar sersüzlär onıtılaçaq)"

#: kdesu.cpp:62
msgid "Enable terminal output (no password keeping)"
msgstr "Terminalğa çığımnı açası (sersüz saqlamíça)"

#: kdesu.cpp:63
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Östenlek bäyäse: 0 <= bäyä <= 100, 0 beläne keçeräk"

#: kdesu.cpp:64
msgid "Use realtime scheduling"
msgstr "Çınçaq kötterü qullanası"

#: kdesu.cpp:65
msgid "Let command use existing dcopserver"
msgstr "Boyırıqqa barlıqtağı dcopserver qullanırğa birü"

#: kdesu.cpp:66
msgid "Do not display ignore button"
msgstr ""

#: kdesu.cpp:67
msgid "Specify icon to use in the password dialog"
msgstr "Sersüz täräzäsendä qullanası tamğa bilgeläw"

#: kdesu.cpp:68
msgid "Do not show the command to be run in the dialog"
msgstr "Eşlätäse boyırıqnı bu täräzädä kürsätmäskä"

#: kdesu.cpp:99
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:100
msgid "Runs a program with elevated privileges."
msgstr "Yazılımnı kütärelgän östenlek belän cibärü."

#: kdesu.cpp:103
msgid "Maintainer"
msgstr "Bulışuçı"

#: kdesu.cpp:105
msgid "Original author"
msgstr "Baş yazuçı"

#: kdesu.cpp:131
msgid "Command '%1' not found."
msgstr "\"%1\" boyırığı tabılmadı."

#: kdesu.cpp:207
#, c-format
msgid "Illegal priority: %1"
msgstr "Yaraqsız östenlek: %1"

#: kdesu.cpp:235
msgid "No command specified."
msgstr "Boyırıq birelmäde."

#: kdesu.cpp:344
msgid ""
"Su returned with an error.\n"
msgstr ""
"Su ber xatanı belän qaytarttı.\n"

#: kdesu.cpp:365
msgid "Command:"
msgstr "Boyırıq:"

#: kdesu.cpp:370
msgid "realtime: "
msgstr "çınçaq: "

#: kdesu.cpp:373
msgid "Priority:"
msgstr "Möhimlek:"

#: sudlg.cpp:29
#, c-format
msgid "Run as %1"
msgstr "%1 adınnan Cibär"

#: sudlg.cpp:33
msgid "Please enter your password."
msgstr ""

#: sudlg.cpp:36
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"Bu eş qılu öçen root xoquqları kiräk. Xäzer root sersüzen kertäse qala, yä ki "
"Qarama östenä çirtep biredäge xoquqlar belän däwam itäse."

#: sudlg.cpp:40
msgid ""
"The action you requested needs additional privileges. Please enter the password "
"for \"%1\" below or click Ignore to continue with your current privileges."
msgstr ""
"Bu soralğan eş qılu öçen östämä xoquqlar kiräk. Xäzer \"%1\" öçen sersüz "
"kertäse qala, yä ki Qarama östenä çirtep biredäge xoquqlar belän däwam itäse."

#: sudlg.cpp:48
msgid "&Ignore"
msgstr "&Uzası"

#: sudlg.cpp:64
msgid "Conversation with su failed."
msgstr "su aşa äyländerü uzmadı."

#: sudlg.cpp:73
msgid ""
"The program 'su' is not found;\n"
"make sure your PATH is set correctly."
msgstr ""
"'su' atlı yazılım tabılmadı;\n"
"biredäge PATH tieşleçä köylängän buluın tikşeräse."

#: sudlg.cpp:80
msgid ""
"You are not allowed to use 'su';\n"
"on some systems, you need to be in a special group (often: wheel) to use this "
"program."
msgstr ""
"'su' qullanu tíılğan;\n"
"bu yazılımnı qullanu öçen, qayber sistemnärdä nindider törkemgä kergän buluı "
"kiräk (yış: wheel)."

#: sudlg.cpp:87
msgid "Incorrect password; please try again."
msgstr "Sersüz kileşmäde; tağın kertep qara."

#: sudlg.cpp:91
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Eçke xata: SuProcess::checkInstall() qaytarğanı yaraqsız"


#: kfmclient.cc:52
msgid "kfmclient"
msgstr "kfmclient"

#: kfmclient.cc:54
msgid "KDE tool for opening URLs from the command line"
msgstr "Boyıru yulınnan URL açu öçen KDE-qoral"

#: kfmclient.cc:64
msgid "Non interactive use: no message boxes"
msgstr "Aralaşsız qullanu: belderü täräzäläre yuq"

#: kfmclient.cc:65
msgid "Show available commands"
msgstr "Barlıq boyırıqlar kürsätü"

#: kfmclient.cc:66
msgid "Command (see --commands)"
msgstr "Boyırıq (--commands uqísı)"

#: kfmclient.cc:67
msgid "Arguments for command"
msgstr "Boyırıq öçen köylämälär"

#: kfmclient.cc:83
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Nöhü:\n"

#: kfmclient.cc:84
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, $HOME is used instead.\n"
"\n"
msgstr ""
"  kfmclient openURL 'url' ['mime-tör']\n"
"            # 'url' kürsätkän täräzä aça.\n"
"            #  'url' digäne bonnan tayanğan yul da bula ala,\n"
"            #   . kebek birem dä, eçtörgäk/ tä\n"
"            #   'url' töşerelgän bulsa, $HOME qullanılaçaq.\n"
"\n"

#: kfmclient.cc:89
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it to\n"
"            #   text/html for a web page, to make it appear faster\n"
"\n"
msgstr ""
"            # 'mime-töre' bilgelängän bulsa, Konqueror qullanırğa tieş bulğan\n"
"            #   komponent şuña qarap saylanaçaq. Ürnäk öçen\n"
"            #   text/html digän tören saylasaq, anı açu tızräk bulaçaq\n"
"\n"

#: kfmclient.cc:93
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient newTab 'url' ['mime-tör']\n"
"            # Östäge belän ber, läkin ağımdağı östäldä bulğan Konqueror\n"
"            #   täräzäseneñ yaña tabağında 'url' aça, eşläp bulsa inde\n"
"\n"

#: kfmclient.cc:97
msgid ""
"  kfmclient openProfile 'profile' ['url']\n"
"            # Opens a window using the given profile.\n"
"            #   'profile' is a file under ~/.kde/share/apps/konqueror/profiles.\n"
"            #   'url' is an optional URL to open.\n"
"\n"
msgstr ""
"  kfmclient openProfile 'caybirem' ['url']\n"
"            # Äytelgän caybirem belän täräzä aça.\n"
"            #   'caybirem' ~/.kde/share/apps/konqueror/profiles törgägennän\n"
"            #   'url' – açası URL.\n"
"\n"

#: kfmclient.cc:102
msgid ""
"  kfmclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kfmclient openProperties 'url'\n"
"            # Üzençäleklär saylağın aça\n"
"\n"

#: kfmclient.cc:104
msgid ""
"  kfmclient exec ['url' ['binding']]\n"
"            # Tries to execute 'url'. 'url' may be a usual\n"
"            #   URL, this URL will be opened. You may omit\n"
"            #   'binding'. In this case the default binding\n"
msgstr ""
"  kfmclient exec ['url' ['binding']]\n"
"            # 'url' eşlätep qarí. 'url' bonda ğädäti URL,\n"
"            #   bu URL açılğan bulaçaq. 'binding'\n"
"            #   köylämäsen töşerep bula.\n"

#: kfmclient.cc:108
msgid ""
"            #   is tried. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
msgstr ""
"            #   sınaldı. Bu URL bularaq berär istälek URLı,\n"
"            #   yä ki *.desktop bireme bula ala.\n"

#: kfmclient.cc:110
msgid ""
"            #   This way you could for example mount a device\n"
"            #   by passing 'Mount default' as binding to \n"
"            #   'cdrom.desktop'\n"
"\n"
msgstr ""
"            #   Ürnäk öçen, 'cdrom.desktop' belän bäylägändä\n"
"            #   'Töp itep taq' digän köylämä qullanıp ta\n"
"            #   şul cıhaznı tağıp bula\n"
"\n"

#: kfmclient.cc:113
msgid ""
"  kfmclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kfmclient move 'bonnan' 'boña'\n"
"            # URL'nı 'bonnan' 'boña' küçerä.\n"
"            #   'bonnan' digäne berär URL tezmäse dä bula ala.\n"

#: kfmclient.cc:118
msgid ""
"  kfmclient download ['src']\n"
"            # Copies the URL 'src' to a user specified location'.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  kfmclient download ['qaydan']\n"
"            # 'qaydan' digän URL'nı äytelgän urınlaşuğa alıp quya.\n"
"            #   'qaydan' digäne berär URL tezmäse dä bula ala, ägär ul yuq ikän, \n"
"            #   şul çaqta URL soralğan bulaçaq.\n"
"\n"

#: kfmclient.cc:122
msgid ""
"  kfmclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"\n"
msgstr ""
"  kfmclient copy 'bonnan' 'boña'\n"
"            # Bu URL'nı 'bonnan' 'boña' kübäytü.\n"
"            #   'bonnan' digäne berär URL tezmäse dä bula ala.\n"
"\n"

#: kfmclient.cc:125
msgid ""
"  kfmclient sortDesktop\n"
"            # Rearranges all icons on the desktop.\n"
"\n"
msgstr ""
"  kfmclient sortDesktop\n"
"            # Östäldäge tamğalarnı tezep quya.\n"
"\n"

#: kfmclient.cc:127
msgid ""
"  kfmclient configure\n"
"            # Re-read Konqueror's configuration.\n"
"\n"
msgstr ""
"  kfmclient configure\n"
"            # Konqueror caylawın yañadan yöklise.\n"
"\n"

#: kfmclient.cc:129
msgid ""
"  kfmclient configureDesktop\n"
"            # Re-read kdesktop's configuration.\n"
"\n"
msgstr ""
"  kfmclient configureDesktop\n"
"            # Kdesktop caylawın yañadan yöklise.\n"
"\n"

#: kfmclient.cc:132
msgid ""
"*** Examples:\n"
"  kfmclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CD-ROM\n"
"\n"
msgstr ""
"*** Ürnäk:\n"
"  kfmclient exec file:/root/Desktop/cdrom.desktop \"CD totaştıru\"\n"
"             // CD-ROM totaştıra\n"
"\n"

#: kfmclient.cc:135
msgid ""
"  kfmclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kfmclient exec file:/home/weis/data/sinaw.html\n"
"             // Bu biremne töp bäyläw belän aça\n"
"\n"

#: kfmclient.cc:137
msgid ""
"  kfmclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kfmclient exec file:/home/weis/data/sinaw.html Netscape\n"
"             // Bu biremne netscape belän aça\n"
"\n"

#: kfmclient.cc:139
msgid ""
"  kfmclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kfmclient exec ftp://localhost/\n"
"             // Yaña täräzäne URL belän aça\n"
"\n"

#: kfmclient.cc:141
msgid ""
"  kfmclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kfmclient exec file:/root/Desktop/emacs.desktop\n"
"             // emacs cibärä\n"
"\n"

#: kfmclient.cc:143
msgid ""
"  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CD-ROM's mount directory\n"
"\n"
msgstr ""
"  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Bu CD-ROM tağılğan törgäkne aça\n"
"\n"

#: kfmclient.cc:145
msgid ""
"  kfmclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kfmclient exec .\n"
"             // Biredäge törgäkne aça. Bik kileşä.\n"
"\n"

#: kfmclient.cc:398
msgid "Profile %1 not found\n"
msgstr "%1 atlı caybirem tabılmadı\n"

#: kfmclient.cc:435
msgid "Syntax Error: Not enough arguments\n"
msgstr "Cömlä Xatası: Köylämälär citmi\n"

#: kfmclient.cc:440
msgid "Syntax Error: Too many arguments\n"
msgstr "Cömlä Xatası: Artıq köylämälär\n"

#: kfmclient.cc:559
msgid "Unable to download from an invalid URL."
msgstr "Yaraqsız URL'dan iñderep bulmadı."

#: kfmclient.cc:623
msgid "Syntax Error: Unknown command '%1'\n"
msgstr "Cömlä Xatası: '%1' digän boyırıq bilgesez\n"

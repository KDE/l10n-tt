#: fonts.cpp:557
msgid "Used for normal text (e.g. button labels, list items)."
msgstr "Ğädäti yazma öçen totılğan (ü.ö. töymä yazmasıtezmä keremnäre)."

#: fonts.cpp:558
msgid "A non-proportional font (i.e. typewriter font)."
msgstr "Nisbätle bulmağan yazu (ü.ö. typewriter yazuı)."

#: fonts.cpp:559
msgid "Used to display text beside toolbar icons."
msgstr "Qoraltirädäge töymä yazmalarda totılğan."

#: fonts.cpp:560

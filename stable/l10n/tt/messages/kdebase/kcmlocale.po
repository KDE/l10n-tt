#: localetime.cpp:464
msgid ""
"<p>The text in this textbox will be used to format time strings. The sequences "
"below will be replaced:</p>"
"<table>"
"<tr>"
"<td><b>HH</b></td>"
"<td>The hour as a decimal number using a 24-hour clock (00-23).</td></tr>"
"<tr>"
"<td><b>hH</b></td>"
"<td>The hour (24-hour clock) as a decimal number (0-23).</td></tr>"
"<tr>"
"<td><b>PH</b></td>"
"<td>The hour as a decimal number using a 12-hour clock (01-12).</td></tr>"
"<tr>"
"<td><b>pH</b></td>"
"<td>The hour (12-hour clock) as a decimal number (1-12).</td></tr>"
"<tr>"
"<td><b>MM</b></td>"
"<td>The minutes as a decimal number (00-59).</td>"
"<tr>"
"<tr>"
"<td><b>SS</b></td>"
"<td>The seconds as a decimal number (00-59).</td></tr>"
"<tr>"
"<td><b>AMPM</b></td>"
"<td>Either \"am\" or \"pm\" according to the given time value. Noon is treated "
"as \"pm\" and midnight as \"am\".</td></tr></table>"
msgstr ""
"<p>Bu qırdağı yazma buyınça çaq kürsätü tärtibe bilgelänä:</p>"
"<table>"
"<tr>"
"<td><b>HH</b></td>"
"<td>Säğätneñ sanı, 24-säğätle küreneş buyınça (00-23).</td></tr>"
"<tr>"
"<td><b>hH</b></td>"
"<td>Säğätneñ sanı, 24-säğätle küreneş buyınça (0-23).</td></tr>"
"<tr>"
"<td><b>PH</b></td>"
"<td>Säğätneñ sanı, 12-säğätle küreneş buyınça (01-12).</td></tr>"
"<tr>"
"<td><b>pH</b></td>"
"<td>Säğätneñ sanı, 12-säğätle küreneş buyınça (1-12).</td></tr>"
"<tr>"
"<td><b>MM</b></td>"
"<td>Minutlar sanı (00-59).</td></tr>"
"<tr>"
"<td><b>SS</b></td>"
"<td>Sekundlar sanı (00-59).</td></tr>"
"<tr>"
"<td><b>TXTS</b></td>"
"<td>Çaqnıñ töşkä bäyle bulu bilgese. \"tx\" - töşkä xätle. \"ts\" - töştän "
"soñ.</td></tr></table>"

#: localetime.cpp:487
msgid ""
"<table>"
"<tr>"
"<td><b>YYYY</b></td>"
"<td>The year with century as a decimal number.</td></tr>"
"<tr>"
"<td><b>YY</b></td>"
"<td>The year without century as a decimal number (00-99).</td></tr>"
"<tr>"
"<td><b>MM</b></td>"
"<td>The month as a decimal number (01-12).</td></tr>"
"<tr>"
"<td><b>mM</b></td>"
"<td>The month as a decimal number (1-12).</td></tr>"
"<tr>"
"<td><b>SHORTMONTH</b></td>"
"<td>The first three characters of the month name. </td></tr>"
"<tr>"
"<td><b>MONTH</b></td>"
"<td>The full month name.</td></tr>"
"<tr>"
"<td><b>DD</b></td>"
"<td>The day of month as a decimal number (01-31).</td></tr>"
"<tr>"
"<td><b>dD</b></td>"
"<td>The day of month as a decimal number (1-31).</td></tr>"
"<tr>"
"<td><b>SHORTWEEKDAY</b></td>"
"<td>The first three characters of the weekday name.</td></tr>"
"<tr>"
"<td><b>WEEKDAY</b></td>"
"<td>The full weekday name.</td></tr></table>"
msgstr ""
"<table>"
"<tr>"
"<td><b>YYYY</b></td>"
"<td>Dürt-bilgele yıl formatı.</td></tr>"
"<tr>"
"<td><b>YY</b></td>"
"<td>İke-bilgele yıl formatı (00-99).</td></tr>"
"<tr>"
"<td><b>AA</b></td>"
"<td>Ay sanı, barçaqta ike-bilgele (01-12).</td></tr>"
"<tr>"
"<td><b>aA</b></td>"
"<td>Ay sanınıñ başındağı 0 kürsätelmi (1-12).</td></tr>"
"<tr>"
"<td><b>AYADIQISQA</b></td>"
"<td>Ay adınıñ berençe öç xärefe. </td></tr>"
"<tr>"
"<td><b>AY</b></td>"
"<td>Aynıñ tulı iseme.</td></tr>"
"<tr>"
"<td><b>KK</b></td>"
"<td>Ay köne, ike bilgedän tora (01-31).</td></tr>"
"<tr>"
"<td><b>kK</b></td>"
"<td>Ay köneneñ başında 0 kürsätelmi (1-31).</td></tr>"
"<tr>"
"<td><b>KÖNADIQISQA</b></td>"
"<td>Atna köneneñ berençe öç xärefe.</td></tr>"
"<tr>"
"<td><b>KÖNADI</b></td>"
"<td>Atna köneneñ tulı adı.</td></tr></table>"


#: kasprefsdlg.cpp:198
msgid "Enables pseudo-transparent mode."
msgstr "Almaş-ütäkürenü ısulın açu."

#: kasprefsdlg.cpp:202
msgid "Enable t&int"
msgstr "&Tösmer belän"

#: kasprefsdlg.cpp:204
msgid "Enables tinting the background that shows through in transparent mode."
msgstr "Arqa plannı tonıqlawnı sälätländerä."

#: kasprefsdlg.cpp:210
msgid "Specifies the color used for the background tint."
msgstr "Arqa plannı tonıqlawda qullanılğan tösne bilgeli."

#: kasprefsdlg.cpp:214
msgid "Tint &color:"
msgstr "Tonıqlaw häm tös:"

#: kasprefsdlg.cpp:223

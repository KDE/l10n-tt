#, no-c-format
msgid "General"
msgstr "Töptän"

#. i18n: file smserverconfigdlg.ui line 51
#: rc.cpp:9
#, no-c-format
msgid "Conf&irm logout"
msgstr "Çığunı &raslaw"

#. i18n: file smserverconfigdlg.ui line 54
#: rc.cpp:12
#, no-c-format
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""
"Bu köylämä yanıq ikän, sessidän çıqqanda çığu belän kileşüne sorí torğan täräzä "
"kürsäteläçäk."

#. i18n: file smserverconfigdlg.ui line 62
#: rc.cpp:15
#, no-c-format
msgid "O&ffer shutdown options"
msgstr "Sünderü ısulların &kürsätäse"

#. i18n: file smserverconfigdlg.ui line 72
#: rc.cpp:18
#, no-c-format
msgid "On Login"
msgstr "Kergändä"

#. i18n: file smserverconfigdlg.ui line 79
#: rc.cpp:21
#, no-c-format
msgid ""
"<ul>\n"
"<li><b>Restore previous session:</b> Will save all applications running on exit "
"and restore them when they next start up</li>\n"
"<li><b>Restore manually saved session: </b> Allows the session to be saved at "
"any time via \"Save Session\" in the K-Menu. This means the currently started "
"applications will reappear when they next start up.</li>\n"
"<li><b>Start with an empty session:</b> Do not save anything. Will come up with "
"an empty desktop on next start.</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li><b>Uzğan sessine torğızu:</b> Sessidän çıqqançı eşlägän yazılımnar "
"saqlanıp, yaña sessi açılğanda torğızılğan bulaçaq</li>\n"
"<li><b>Qulsan saqlanğan sessi torğızu: </b> K-Saylaqnıñ \"Seesi Saqlaw\" digän "
"kerem aşa saqlanğan sessine torğızırğa birä, yäğni biredä eşlägän yazılımnar "
"saqlanıp, yaña sessi açılğanda torğızılğan bulaçaq.</li>\n"
"<li><b>Buş sessi belän başlísı:</b> Berni dä saqlamasqa. Yaña sessi "
"cibärelgändä ul buş bulaçaq.</li>\n"
"</ul>"

#. i18n: file smserverconfigdlg.ui line 90
#: rc.cpp:28
#, no-c-format
msgid "Restore &previous session"
msgstr "&Uzğan sessine torğız"

#. i18n: file smserverconfigdlg.ui line 98

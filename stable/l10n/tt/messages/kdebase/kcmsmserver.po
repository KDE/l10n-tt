msgstr "Kiñäytep"

#. i18n: file smserverconfigdlg.ui line 167
#: rc.cpp:55
#, no-c-format
msgid "Applications to be e&xcluded from sessions:"
msgstr "Sessilärdän &töşeräse yazılımnar::"

#. i18n: file smserverconfigdlg.ui line 179
#: rc.cpp:58
#, fuzzy, no-c-format
msgid ""
"Here you can enter a colon-separated list of applications that should not be "
"saved in sessions, and therefore will not be started when restoring a session. "
"For example 'xterm:xconsole'.\n"
msgstr ""
"Sessi eçendä saqlamasqa digän yazılımnar tezmäsen öter belän aralaştırıp bonda "
"kiterergä bula, sessilär torğızılğanda alar cibärelmäyäçäk. Ürnäk öçen "
"'xterm,xconsole'."

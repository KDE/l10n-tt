#, no-c-format
msgid "Restore &manually saved session"
msgstr "&Quldan saqlağan sessine torğız"

#. i18n: file smserverconfigdlg.ui line 106
#: rc.cpp:34
#, no-c-format
msgid "Start with an empty &session"
msgstr "Buş &sessi belän yöklänäse"

#. i18n: file smserverconfigdlg.ui line 116
#: rc.cpp:37
#, no-c-format
msgid "Default Shutdown Option"
msgstr "Sünderü Öçen Töp Cay"

#. i18n: file smserverconfigdlg.ui line 119
#: rc.cpp:40
#, no-c-format
msgid ""
"Here you can choose what should happen by default when you log out. This only "
"has meaning, if you logged in through KDM."
msgstr ""
"Sistemnän çıqqanda töpcay bulıp ni eşlänergä tişkegen bonda saylarğa bula. "
"Kereş KDM aşa uzğan bulsa ğına bu köylämä eşläyäçäk."


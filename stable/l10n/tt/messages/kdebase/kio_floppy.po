#: kio_floppy.cpp:200
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"%1 cıhazına ireşep bulmadı.\n"
"Ul cıhaz haman da eştä.\n"
"Anıñ buşayğanın kötep, qabat ireşep qarísı."

#: kio_floppy.cpp:204 kio_floppy.cpp:1146
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"%1 biremenä yazıp bulmadı.\n"
"%2 cıhazındağı disk buluına oşí."

#: kio_floppy.cpp:214
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"%1 taba ireşep bulmadı.\n"
"%2 cıhazında disk bulmawı bar"

#: kio_floppy.cpp:218
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough permissions "
"to access the drive."
msgstr ""
"%1 taba ireşep bulmadı.\n"
"%2 cıhazında disk bulmawı, yä ul cıhazğa ireşerlek xoquqlar citmäwe bar."

#: kio_floppy.cpp:222
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"%1 taba ireşep bulmadı.\n"
"%2 cıhazı totılmí"

#: kio_floppy.cpp:227
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set correctly "
"(e.g. rwxrwxrwx)."
msgstr ""
"%1 taba ireşep bulmadı.\n"
"%2 cıhazındağı disk DOS-formatlı buluın tikşerep, \n"
"ul cıhaz biremenä (ü.ö. /dev/fd0) xoquqlarnıñ döres quyıluın tikşerergä kiräk "
"(ü.ö. rwxrwxrwx)."

#: kio_floppy.cpp:231
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"%1 taba ireşep bulmadı.\n"
"%2 cıhazındağı disk DOS-formatlı tügel axrısı."

#: kio_floppy.cpp:235
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"İreşü tíıldı.\n"
"%1 eçenä yazıp bulmí.\n"
"%2 cıhazındağı disk tağın yazudan saqlanğan kebek."

#: kio_floppy.cpp:244
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"%1 öçen yöklänü yazmasın uqıp bulmí.\n"
"%2 cıhazında disk bulmawı bar."

#: kio_floppy.cpp:368
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"\"%1\" yazılımın eşlätep bulmadı.\n"
"Mtools tuplaması bu sistemgä döres quyıluın tikşerep alası."

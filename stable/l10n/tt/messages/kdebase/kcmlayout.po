#, no-c-format
msgid "Shows country flag on background of layout name in tray icon"
msgstr "Ulaqnıñ köyläneş adı belän tamğa asyağında il bayırağın kürsätäse"

#. i18n: file kcmlayoutwidget.ui line 487
#: rc.cpp:101
#, no-c-format
msgid "Sticky Switching"
msgstr "Köyläneş Küçergeçe"

#. i18n: file kcmlayoutwidget.ui line 498
#: rc.cpp:104
#, no-c-format
msgid "Enable sticky switching"
msgstr "Yabışmalı itüne açası"

#. i18n: file kcmlayoutwidget.ui line 501
#: rc.cpp:107
#, no-c-format
msgid ""
"If you have more than two layouts and turn this option on, switching with the "
"keyboard shortcut or clicking on the kxkb indicator will only cycle through the "
"last few layouts. You can specify the number of layouts to rotate below. You "
"can still access all layouts by right-clicking on the kxkb indicator."
msgstr ""
"İkedän dä kübräk köyläneş quyılğan bulsa, bu köylämäne açıp, töymäle çaptırma "
"aşa üzägrtep bulğan köyläneş sanın çikläp bula, başqa köyläneşlärgä isä kxkb "
"bayrağına uñ çirtü aşa ireşep bulaçaq."

#. i18n: file kcmlayoutwidget.ui line 512
#: rc.cpp:110
#, no-c-format
msgid "Number of layouts to rotate:"
msgstr "Töp köyläneşlär sanı:"

#. i18n: file kcmlayoutwidget.ui line 539
#: rc.cpp:113
#, no-c-format
msgid "Show indicator for single layout"
msgstr "Yalğız köyläşkä dä bayıraq kürsätäse"


#: runapplet.cpp:59
msgid "Run command:"
msgstr "Eşlätü ämere:"

#: runapplet.cpp:170
msgid "< Run"
msgstr "< Cibär"

#: runapplet.cpp:177
msgid "Run >"
msgstr "Cibär >"

#: runapplet.cpp:226
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "Baştan, cibäräse boyırıq yä açası URL kertäse bar."

#: runapplet.cpp:237
msgid ""
"Unable to log out properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will not "
"be saved with a forced shutdown."
msgstr ""
"Tieşleçä çığıp bulmadı.\n"
"Sessi idäräçe belän aralaşıp bulmí. Xäzer Ctrl+Alt+Backspace basıp, köçläp "
"tuqtatıp qararğa bula. Köçläp tuqtatqanda biredäge sessi saqlanmí qalaçaq."

#: runapplet.cpp:268
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt><b>%1</b> atlı yazılım da, boyırıq ta tabılmadı\n"
"Anı tkşerep alıp, tağın cibärep qararğa bula</qt>"

#: runapplet.cpp:280
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt><b>%1</b> digänen cibärep bulmí.\n"
"Bu boyırıq/URL tözätep, qabat cibärep qarísı.</qt>"

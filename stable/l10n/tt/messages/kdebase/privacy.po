#. i18n: file kprivacysettings.ui line 127
#: rc.cpp:46
#, no-c-format
msgid "Health Information"
msgstr "İsän-Sawlıq Turında"

#. i18n: file kprivacysettings.ui line 138
#: rc.cpp:49
#, no-c-format
msgid "Warn me when I visit a site that uses my health or medical information: "
msgstr "Minem isän-sawlıq turında belemne qullanğan säxifägä kergän çaqta mine belderäse: "

#. i18n: file kprivacysettings.ui line 164
#: rc.cpp:58
#, no-c-format
msgid "Demographics"
msgstr "Sünawsızım"

#. i18n: file kprivacysettings.ui line 175
#: rc.cpp:61
#, no-c-format
msgid "Warn me when I visit a site that uses my non-personally identifiable information:"
msgstr "Minem turında bulmağan belemne qullanğan säxifägä kergän çaqta mine belderäse:"

#. i18n: file kprivacysettings.ui line 183
#: rc.cpp:64
#, no-c-format
msgid "To determine my interests, habits or general behavior"
msgstr "Üz qızıqsınu-şöğellänülär belderü öçen"

#. i18n: file kprivacysettings.ui line 201
#: rc.cpp:70
#, no-c-format
msgid "Warn me when I visit a site that shares my personal information with other companies"
msgstr "Minem turında belemne başqa şerkätlär belän büleşkän säxifägä kergän çaqta mine belderäse"

#. i18n: file kprivacysettings.ui line 209
#: rc.cpp:73
#, no-c-format
msgid "Warn me when I visit a site that does not let me know what information they have about me"
msgstr "Minem turında ni belgänen äytmägän säxifägä kergän çaqta mine belderäse"

#. i18n: file kprivacysettings.ui line 217
#: rc.cpp:76
#, no-c-format
msgid "Personal Information"
msgstr "Şäxes Turında"

#. i18n: file kprivacysettings.ui line 228
#: rc.cpp:79
#, no-c-format
msgid "Warn me when I visit a site that may contact me about other products or services:"
msgstr "Başqa eşlänmä yä ki xezmätlär turında äytä belgän säxifägä kergän çaqta mine belderäse:"

#. i18n: file kprivacysettings.ui line 236
#: rc.cpp:82
#, no-c-format
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr "Minem turında belemne qullana alğan säxifägä kergän çaqta mine belderäse:"

#. i18n: file kprivacysettings.ui line 244
#: rc.cpp:85
#, no-c-format
msgid "Determine my habits, interests or general behavior"
msgstr "Şöğellänülär belän qızıqsınularımnı bilgeläw"

#. i18n: file kprivacysettings.ui line 260
#: rc.cpp:88
#, no-c-format
msgid "Via telephone"
msgstr "Telefon aşa"

#. i18n: file kprivacysettings.ui line 268
#: rc.cpp:91
#, no-c-format
msgid "Via mail"
msgstr "Xat aşa"

#. i18n: file kprivacysettings.ui line 286
#: rc.cpp:94
#, no-c-format
msgid "Via email"
msgstr "Email aşa"

#. i18n: file kprivacysettings.ui line 294
#: rc.cpp:97
#, no-c-format
msgid "And do not allow me to remove my contact information"
msgstr "Üz turında belemne beterergä birmäskä"

msgstr "<nobr><qt><b>Sessineñ Üzennän-üze Yabıluı</b></qt><nobr>"

#: lock/autologout.cc:40
msgid ""
"<qt>To prevent being logged out, resume using this session by moving the mouse "
"or pressing a key.</qt>"
msgstr ""
"<qt>Küse selketep yä berär töymägä basıp, bu sessidän çıqmíça eşne däwam itärgä "
"bula.</qt>"


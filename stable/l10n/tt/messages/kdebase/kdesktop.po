msgstr "Küräk saqlawçınıñ kötü arası"

#. i18n: file kdesktop.kcfg line 231
#: rc.cpp:268
#, no-c-format
msgid "Sets the seconds after which the screen saver is started."
msgstr "Küräk saqlağıçın niçä sekundtan soñ cibäräsen bilgeli."

#. i18n: file kdesktop.kcfg line 235
#: rc.cpp:271
#, no-c-format
msgid "Disable screen saver during presentation or TV"
msgstr ""

#. i18n: file kdesktop.kcfg line 236
#: rc.cpp:274
#, fuzzy, no-c-format
msgid ""
"Enable this option if you want to disable the screen saver while watching TV or "
"movies."
msgstr "Monı açıp, asyaq öçen bülenäçäk alxäter külämen çiklärgä bula."


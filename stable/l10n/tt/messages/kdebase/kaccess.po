#: kaccess.cpp:408
msgid "Change Settings Without Asking"
msgstr "Caylawnı Sorawsızına Almaştır"

#: kaccess.cpp:409
msgid "Show This Confirmation Dialog"
msgstr "Bu Raslaw Täräzäsen Kürsät"

#: kaccess.cpp:410
msgid "Deactivate All AccessX Features & Gestures"
msgstr "AccessX Çağılışlarınıñ Barısın da Sünder"

#: kaccess.cpp:447 kaccess.cpp:449
msgid "Sticky keys"
msgstr "Yabışulı töymä"

#: kaccess.cpp:452 kaccess.cpp:454
msgid "Slow keys"
msgstr "Äkren töymälär"

#: kaccess.cpp:457 kaccess.cpp:459

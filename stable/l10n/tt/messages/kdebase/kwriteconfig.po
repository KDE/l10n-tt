#: kwriteconfig.cpp:19
msgid "Use <file> instead of global config"
msgstr "Ğömümi caybirem urınına <file> qullanası"

#: kwriteconfig.cpp:20
msgid "Group to look in"
msgstr "Nindi törkemdä ezlise"

#: kwriteconfig.cpp:21
msgid "Key to look for"
msgstr "Nindi açqıç ezlise"

#: kwriteconfig.cpp:22
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Üzgärelmä töre. Yuqbar öçen \"bool\" qullanası, yä isä ul sätir kebek "
"qullanılır"

#: kwriteconfig.cpp:23
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "Saqlaw öçen bäyä. Mäcbüri. Buş bulsa, qabıqta '' qullanası"

#: kwriteconfig.cpp:28
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:30
msgid "Write KConfig entries - for use in shell scripts"
msgstr "KConfig keremnär yazu - qabıq ämerleklärendä qullanu öçen"


msgstr "Tiz Gizü töymäse öçen asyaq süräten tüşäw qullanası"

#. i18n: file kickerSettings.kcfg line 200
#: rc.cpp:132
#, no-c-format
msgid "Enable a tile background image for the Window List button"
msgstr "Täräzä Tezmäseneñ töymäse öçen asyaq süräten tüşäw qullanası"

#. i18n: file kickerSettings.kcfg line 205
#: rc.cpp:135
#, no-c-format

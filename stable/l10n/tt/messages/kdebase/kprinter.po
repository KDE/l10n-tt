#: main.cpp:29
msgid "Make an internal copy of the files to print"
msgstr "Bu biremnärne bastıru öçen eşke küçermä yasísı"

#: main.cpp:31
msgid "Printer/destination to print on"
msgstr "Basaq/bastıru cıhazı"

#: main.cpp:33
msgid "Title/Name for the print job"
msgstr "Bu bastıru yöge öçen başlıq"

#: main.cpp:35
msgid "Number of copies"
msgstr "Dänä sanı"

#: main.cpp:36
msgid "Printer option"
msgstr "Basaq köylämäse"

#: main.cpp:37
msgid "Job output mode (gui, console, none)"
msgstr "Yök çığaru ısulı (gui, konsol, yuq)"

#: main.cpp:38
msgid "Print system to use (lpd, cups)"
msgstr "Qullanası bastıru sisteme (lpd, cups)"

#: main.cpp:39
msgid "Allow printing from STDIN"
msgstr "STDIN eçennän bastıru açası"

#: main.cpp:40
msgid "Do not show the print dialog (print directly)"
msgstr "Bastıru täräzäsen kürsätmäskä (turıdan bastırası)"

#: main.cpp:41
msgid "Files to load"
msgstr "Yöklise biremnär"

#: main.cpp:47
msgid "KPrinter"
msgstr "KPrinter"

#: main.cpp:47
msgid "A printer tool for KDE"
msgstr "KDE'nıñ basaq qoralı"

#: printwrapper.cpp:61
msgid "Print Information"
msgstr "Bastıru Turında"

#: printwrapper.cpp:62
msgid "Print Warning"
msgstr "Bastıru Beldermäse"

#: printwrapper.cpp:63
msgid "Print Error"
msgstr "Bastıru Xatası"

#: printwrapper.cpp:69
msgid "Print info"
msgstr "Bastıru turında"

#: printwrapper.cpp:69
msgid "Print warning"
msgstr "Bastıru beldermäse"

#: printwrapper.cpp:69
msgid "Print error"
msgstr "Bastıru xatası"

#: printwrapper.cpp:190
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr "Boyıryulda birem äytelgän buldı. Töp kerem ağımınnan uqu sünderelgän."

#: printwrapper.cpp:196
msgid ""
"When using '--nodialog', you must at least specify one file to print or use the "
"'--stdin' flag."
msgstr ""
"Ägär '--nodialog' köylämäse qullanıla ikän, berär bulsa da birem bilgelängän "
"bulırğa tieş, yä isä  '--stdin' bayırağı."

#: printwrapper.cpp:245
msgid "The specified printer or the default printer could not be found."
msgstr "Saylanğan yä ki töpcay bulğan basaq tabılmadı."

#: printwrapper.cpp:247
msgid "Operation aborted."
msgstr "Eşkärtü özderelde."

#: printwrapper.cpp:276
msgid "Unable to construct the print dialog."
msgstr "Bastıru täräzäsen qorıp bulmí."

#: printwrapper.cpp:317
msgid "Multiple files (%1)"
msgstr "Berniçä birem (%1)"

#: printwrapper.cpp:324
msgid "Nothing to print."
msgstr "Bastırası närsälär yuq."

#: printwrapper.cpp:349
msgid "Unable to open temporary file."
msgstr "Waqıtlı birem açıp bulmadı."

#: printwrapper.cpp:364
msgid "Stdin is empty, no job sent."
msgstr "Stdin buş ikän, yök cibärelmäde."

#: printwrapper.cpp:376
#, c-format
msgid "Unable to copy file %1."
msgstr "%1 biremen kübäytep bulmadı."

#: printwrapper.cpp:393
msgid "Error while printing files"
msgstr "Birem bastırğanda xata"

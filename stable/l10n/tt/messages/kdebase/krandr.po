msgstr "Arqılıdan közgelä"

#: randr.cpp:240
msgid "Mirror vertically"
msgstr "Buydan közgelä"

#: randr.cpp:242 randr.cpp:273
msgid "Unknown orientation"
msgstr "Bilgesez yünälü"

#: randr.cpp:249
msgid "Rotated 90 degrees counterclockwise"
msgstr "Säğät yöreşe buyınça 90 gradusqa borılğan"

#: randr.cpp:251

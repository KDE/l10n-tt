#: randr.cpp:260
msgid "mirrored horizontally and vertically"
msgstr "yatma belän asma buyınça közge"

#: randr.cpp:263
msgid "Mirrored horizontally"
msgstr "Arqılıdan közgelände"

#: randr.cpp:265
msgid "mirrored horizontally"
msgstr "yatma buyınça közge"

#: randr.cpp:268
msgid "Mirrored vertically"
msgstr "Buydan közgelände"

#: randr.cpp:270
msgid "mirrored vertically"
msgstr "asma buyınça közge"

#: randr.cpp:275
msgid "unknown orientation"
msgstr "bilgesez yünälü"


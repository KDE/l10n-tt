#: aboutwidget.cpp:69
msgid "Machine:"
msgstr "Maşína:"

#: dockcontainer.cpp:133
msgid "<big><b>Loading...</b></big>"
msgstr "<big><b>Yökläw...</b></big>"

#: dockcontainer.cpp:201 toplevel.cpp:376
msgid ""
"There are unsaved changes in the active module.\n"
"Do you want to apply the changes before running the new module or discard the "
"changes?"
msgstr ""
"Bu modulda saqlanmağan üzgäreşlär bar.\n"
"Yaña modul cibärgänçe ul üzgäreşlärne aşırası kiläme, yä yuğaltası ğıña mı?"

#: dockcontainer.cpp:204 toplevel.cpp:379
msgid ""
"There are unsaved changes in the active module.\n"
"Do you want to apply the changes before exiting the Control Center or discard "
"the changes?"
msgstr ""
"Bu modulda saqlanmağan üzgäreşlär bar.\n"
"Caylaw Üzägennän çıqqançı ul üzgäreşlärne aşırası kiläme, yä yuğaltası ğıña mı?"

#: dockcontainer.cpp:207 toplevel.cpp:382
msgid "Unsaved Changes"
msgstr "Saqlanmağan Üzgärülär"

#: helpwidget.cpp:44
#, fuzzy
msgid ""
"<p>Use the \"What's This?\" (Shift+F1) to get help on specific options.</p>"
"<p>To read the full manual click <a href=\"%1\">here</a>.</p>"
msgstr ""
"<p>Ayırım köylämä buyınça kiñäş alu öçen \"Ni Bu?\" (Shift+F1) qullanası.</p>"
"<p>Tulırağın <a href=\"%1\">qullanmada</a> uqıp bula.</p>"

#: helpwidget.cpp:51
msgid ""
"<h1>KDE Info Center</h1>There is no quick help available for the active info "
"module."
"<br>"
"<br>Click <a href = \"kinfocenter/index.html\">here</a> "
"to read the general Info Center manual."
msgstr ""
"<h1>KDE'neñ Beleşmä Üzäge</h1>Bu beleşmä modulı öçen yärdäm bite yuq."
"<br>"
"<br>Beleşmä Üzäge turında <a href = \"kinfocenter/index.html\">töp qullanma</a> "
"uqıp bula."

#: helpwidget.cpp:56
msgid ""
"<h1>KDE Control Center</h1>There is no quick help available for the active "
"control module."
"<br>"
"<br>Click <a href = \"kcontrol/index.html\">here</a> "
"to read the general Control Center manual."
msgstr ""
"<h1>KDE Caylaw Üzäge</h1>Bu caylaw modulı öçen yärdäm bite yuq."
"<br>"
"<br>Caylaw Üzäge turında <a href = \"kcontrol/index.html\">töp qullanma</a> "
"uqıp bula."

#: kcrootonly.cpp:30
msgid ""
"<big>You need super user privileges to run this control module.</big>"
"<br>Click on the \"Administrator Mode\" button below."
msgstr ""
"<big>Bu caylaw bülegen cibärü öçen idäräçe bulu kiräk.</big>"
"<br>Astağı \"İdäräçe Isulı\" digän töymägä çirtäse."


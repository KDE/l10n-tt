#: appletproxy.cpp:65
msgid "The applet's desktop file"
msgstr "Bu applet'neñ östäl bireme"

#: appletproxy.cpp:66
msgid "The config file to be used"
msgstr "Bu caybiremne qullanası"

#: appletproxy.cpp:67
msgid "DCOP callback id of the applet container"
msgstr "Bu applet qabığı öçen DCOP eşkärtkeçeneñ id"

#: appletproxy.cpp:73 appletproxy.cpp:75
msgid "Panel applet proxy."
msgstr "Tirä applet araçısı."

#: appletproxy.cpp:97
msgid "No desktop file specified"
msgstr "Östäl bireme bilgelänmäde"

#: appletproxy.cpp:132
msgid ""
"The applet proxy could not be started due to DCOP communication problems."
msgstr "DCOP totaşu qíınlıqlarına säbäple bu applet araçısın cibärep bulmí."

#: appletproxy.cpp:133 appletproxy.cpp:141 appletproxy.cpp:174
#: appletproxy.cpp:195 appletproxy.cpp:297 appletproxy.cpp:322
msgid "Applet Loading Error"
msgstr "Applet Yökläw Xatası"

#: appletproxy.cpp:140
msgid ""
"The applet proxy could not be started due to DCOP registration problems."
msgstr "DCOP terkäw qíınlıqlarına säbäple bu applet araçısın cibärep bulmí."

#: appletproxy.cpp:173
#, c-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "Bu applet araçısı %1 eçennän apllet turında belemne yökli almí."

#: appletproxy.cpp:194
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "%1 digän applet bu applet araçısı aşa cibärelä almí."

#: appletproxy.cpp:296
msgid ""
"The applet proxy could not dock into the panel due to DCOP communication "
"problems."
msgstr ""
"DCOP totaşu qíınlıqlarına säbäple bu applet araçısı bu tirä eçenä utıra almí."

#: appletproxy.cpp:321
msgid "The applet proxy could not dock into the panel."
msgstr "Bu applet araçısı bu tirä eçenä utıra almí."


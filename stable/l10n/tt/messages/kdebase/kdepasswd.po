#: kdepasswd.cpp:24
msgid "Change password of this user"
msgstr "Bu qullanuçı sersüzen üzgärtü"

#: kdepasswd.cpp:31
msgid "KDE passwd"
msgstr "KDE sersüze"

#: kdepasswd.cpp:32
msgid "Changes a UNIX password."
msgstr "UNIX sersüzen almaştıra."

#: kdepasswd.cpp:34
msgid "Maintainer"
msgstr "Bulışuçı"

#: kdepasswd.cpp:60
msgid "You need to be root to change the password of other users."
msgstr "Başqa qullanuçı sersüzen üzgärtü öçen, root sersüzen belü kiräk."

#: passwddlg.cpp:19 passwddlg.cpp:87
msgid "Change Password"
msgstr "Sersüz Üzgärtü"

#: passwddlg.cpp:20
msgid "Please enter your current password:"
msgstr "Xäzerge sersüzeñne kert zinhar:"

#: passwddlg.cpp:41 passwddlg.cpp:159
msgid "Conversation with 'passwd' failed."
msgstr "'passwd' belän aralaşıp bulmadı."

#: passwddlg.cpp:51
msgid "Could not find the program 'passwd'."
msgstr "'passwd' yazılımın tabıp bulmadı."

#: passwddlg.cpp:56
msgid "Incorrect password. Please try again."
msgstr "Yaraqsız sersüz. Tağın kertep qara."

#: passwddlg.cpp:60
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr ""
"Eçke xata: PasswdProcess::checkCurrent yağınnan yaraqsız bäyä qaytarıldı."

#: passwddlg.cpp:89
msgid "Please enter your new password:"
msgstr "Yaña sersüzeñne kert zinhar:"

#: passwddlg.cpp:91
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "<b>%1</b> qullanuçı öçen yaña sersüzne kert zinhar:"

#: passwddlg.cpp:108
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it is."
msgstr ""
"Sersüzeñ 8 bilgedän dä ozınraq. Qayber sistemnärdä ul qíınlıqlarğa kiterä ala. "
"Sersüzne 8 bilge itterep qısqartıp bula, yä inde şul kileş genä dä qaldırırğa "
"yarí."

#: passwddlg.cpp:111
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it is."
msgstr ""
"Bu sersüz 8 bilgedän dä ozınraq. Qayber sistemnärdä ul íiyınlıqlarğa kiterä "
"ala. Sersüzne 8 bilge itterep qısqartıp bula, yä inde şul kileş genä dä "
"qaldırırğa yarí."

#: passwddlg.cpp:115
#, fuzzy
msgid "Password too long"
msgstr "Sersüz Artıq Ozın"

#: passwddlg.cpp:116
msgid "Truncate"
msgstr "Qısqart"

#: passwddlg.cpp:117
#, fuzzy
msgid "Use as is"
msgstr "Bulğanın Qullan"

#: passwddlg.cpp:138
msgid "Your password has been changed."
msgstr "Sersüzeñ üzgärtelgän buldı."

#: passwddlg.cpp:148
msgid "Your password has not been changed."
msgstr "Sezsüzeñ üzgärtelmäde."


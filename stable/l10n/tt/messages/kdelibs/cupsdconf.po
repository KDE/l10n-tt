#: cupsd.conf.template.cpp:1
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Server name (ServerName)</b>\n"
"<p>\n"
"The hostname of your server, as advertised to the world.\n"
"By default CUPS will use the hostname of the system.</p>\n"
"<p>\n"
"To set the default server used by clients, see the client.conf file.</p>\n"
"<p>\n"
"<i>ex</i>: myhost.domain.com</p>\n"
msgstr ""
"<b>Server adı (ServerName)</b>\n"
"<p>\n"
"Çeltärdä urnaşılğan servereñneñ hos adı. Äytelmägän çaqta CUPS bu sistemneñ "
"host adın qullanaçaq.</p>\n"
"<p>Server adı äytelmi qalğan çaqta, client.conf biremendäge cay qullanıla.</p>\n"
"<p><i>ü.ö.</i>: hostim.domain.com</p>\n"

#: cupsd.conf.template.cpp:11
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Server administrator (ServerAdmin)</b>\n"
"<p>\n"
"The email address to send all complaints or problems to.\n"
"By default CUPS will use \"root@hostname\".</p>\n"
"<p>\n"
"<i>ex</i>: root@myhost.com</p>\n"
msgstr ""
"<b>Server İdäräçe (ServerAdmin)</b>\n"
"<p>\n"
"Qıyınlıqlar turında xäbär cibärü öçen email.Äytelmäsä, CUPS \"root@hostname\" "
"adresen qullana.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: root@hostim.com</p>\n"

#: cupsd.conf.template.cpp:19
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Access log (AccessLog)</b>\n"
"<p>\n"
"The access log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/access_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/access_log</p>\n"
msgstr ""
"<b>İreşü köndälege (AccessLog)</b>\n"
"<p>\n"
"İreşü köndälegeneñ bireme bu; ägär ul / bilgesennän başlanmí ikän, şul çaqta "
"ServerRoot törgägenä tayana dip sanala. Äytelmägän çaqta, "
"\"/var/log/cups/access_log\" qullanıla.</p>\n"
"<p>\n"
"Çığımnı \"syslog\" atlı biremgä/xezmätkä yünältü öçen <b>syslog</b> "
"adın kertep qaldırası.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /var/log/cups/access_log</p>\n"

#: cupsd.conf.template.cpp:31
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Data directory (DataDir)</b>\n"
"<p>\n"
"The root directory for the CUPS data files.\n"
"By default /usr/share/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups</p>\n"
msgstr ""
"<b>Biremnär Ttörgäge (DataDir)</b>\n"
"<p>\n"
"CUPS'nıñ eş biremnäre öçen töp törgäk yulı.\n"
"Äytelmäsä, /usr/share/cups dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /usr/share/cups</p>\n"

#: cupsd.conf.template.cpp:39
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Default character set (DefaultCharset)</b>\n"
"<p>\n"
"The default character set to use. If not specified,\n"
"defaults to utf-8.  Note that this can also be overridden in\n"
"HTML documents...</p>\n"
"<p>\n"
"<i>ex</i>: utf-8</p>\n"
msgstr ""
"<b>Töp bilgelämä (DefaultCharset)</b>\n"
"<p>\n"
"Töp bilgelämäneñ adı. Äytelmäsä, utf-8 dip sanala.  HTML istälektä anıñ "
"almaşına aluın da onıtmísı ide...</p>\n"
"<p>\n"
"<i>ö.ü.</i>: ISO 8859-9</p>\n"

#: cupsd.conf.template.cpp:48
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Default language (DefaultLanguage)</b>\n"
"<p>\n"
"The default language if not specified by the browser.\n"
"If not specified, the current locale is used.</p>\n"
"<p>\n"
"<i>ex</i>: en</p>\n"
msgstr ""
"<b>Töp tel (DefaultLanguage)</b>\n"
"<p>\n"
"Gizgeç anı birmägän bulsa, bu köyläw qullanaçaq.\n"
"Äytelmäsä, biredäge illäşterü totıla.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: tt</p>\n"

#: cupsd.conf.template.cpp:56
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Document directory (DocumentRoot)</b>\n"
"<p>\n"
"The root directory for HTTP documents that are served.\n"
"By default the compiled-in directory.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/doc</p>\n"
msgstr ""
"<b>İstäleklär törgäge (DocumentRoot)</b>\n"
"<p>\n"
"HTTP istäleklär yatqan töp törgäk yulı.Äytelmäsä, server cıyılğan çaqta "
"qullanılğan köyläw totılaçaq.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /usr/share/cups/doc</p>\n"

#: cupsd.conf.template.cpp:64
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Error log (ErrorLog)</b>\n"
"<p>\n"
"The error log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/error_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/error_log</p>\n"
msgstr ""
"<b>Xatalar köndälege (ErrorLog)</b>\n"
"<p>\n"
"Xatalar köndälegeneñ bireme bu; ägär ul / bilgesennän başlanmí ikän, şul çaqta "
"ServerRoot törgägenä tayana dip sanala. Äytelmägän çaqta, "
"\"/var/log/cups/error_log\" qullanıla.</p>\n"
"<p>\n"
"Çığımnı \"syslog\" atlı biremgä/xezmätkä yünältü öçen <b>syslog</b> "
"adın kertep qaldırası.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /var/log/cups/error_log</p>\n"

#: cupsd.conf.template.cpp:76
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Font path (FontPath)</b>\n"
"<p>\n"
"The path to locate all font files (currently only for pstoraster).\n"
"By default /usr/share/cups/fonts.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/fonts</p>\n"
msgstr ""
"<b>Yazular yulı (FontPath)</b>\n"
"<p>\n"
"Bar yazu biremnären ezläw öçen yul bu (biredä, <i>pstoraster</i> öçen genä).\n"
"Äytelmäsä, /usr/share/cups/fonts dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /usr/share/cups/fonts</p>\n"

#: cupsd.conf.template.cpp:84
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Log level (LogLevel)</b>\n"
"<p>\n"
"Controls the number of messages logged to the ErrorLog\n"
"file and can be one of the following:</p>\n"
"<ul type=circle>\n"
"<li><i>debug2</i>:     Log everything.</li>\n"
"<li><i>debug</i>:     Log almost everything.</li>\n"
"<li><i>info</i>:      Log all requests and state changes.</li>\n"
"<li><i>warn</i>:      Log errors and warnings.</li>\n"
"<li><i>error</i>:     Log only errors.</li>\n"
"<li><i>none</i>:      Log nothing.</li>\n"
"</ul>"
"<p>\n"
"<i>ex</i>: info</p>\n"
msgstr ""
"<b>Köndälekläw däräcäse (LogLevel)</b>\n"
"<p>\n"
"ErrorLog köylämäsendä äytelgän birem eçenä yazıp barası xäbär sanın bilgeli. Ul "
"bolardan bula ala:</p>\n"
"<ul type=circle>\n"
"<li><i>debug2</i>:     Barısın da yazıp barası.</li>\n"
"<li><i>debug</i>:     Barısın da diärlek yazıp barası.</li>\n"
"<li><i>info</i>:      Bar sorawlar belän xälät üzgäreşlären yazıp barası.</li>\n"
"<li><i>warn</i>:      Xatalar belän kisätmälär yazıp barası.</li>\n"
"<li><i>error</i>:     Xatalar ğına yazıp barası.</li>\n"
"<li><i>none</i>:      Berni yazmasqa.</li>\n"
"</ul>"
"<p>\n"
"<i>ü.ö</i>: info</p>\n"

#: cupsd.conf.template.cpp:99
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Max log size (MaxLogSize)</b>\n"
"<p>\n"
"Controls the maximum size of each log file before they are\n"
"rotated.  Defaults to 1048576 (1MB).  Set to 0 to disable log rotating.</p>\n"
"<p>\n"
"<i>ex</i>: 1048576</p>\n"
msgstr ""
"<b>Köndälek külämen çikläw (MaxLogSize)</b>\n"
"<p>\n"
"Köndälek biremeneñ küläme bu çikkä citgäç, ul äyländerelgän bulaçaq. Äytelmäsä, "
"çige 1048576 bayt (1MB) dip sanala. Bäyäne 0 itep quyu, köndälek äyländerüen "
"sünderä.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 1048576</p>\n"

#: cupsd.conf.template.cpp:107
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Page log (PageLog)</b>\n"
"<p>\n"
"The page log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/page_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/page_log</p>\n"
msgstr ""
"<b>Bastıru köndälege (PageLog)</b>\n"
"<p>\n"
"Bastıru köndälegeneñ bireme bu; ägär ul / bilgesennän başlanmí ikän, şul çaqta "
"ServerRoot törgägenä tayana dip sanala. Äytelmägän çaqta, "
"\"/var/log/cups/page_log\" qullanıla.</p>\n"
"<p>\n"
"Çığımnı \"syslog\" atlı biremgä/xezmätkä yünältü öçen <b>syslog</b> "
"adın kertep qaldırası.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /var/log/cups/page_log</p>\n"

#: cupsd.conf.template.cpp:119
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Preserve job history (PreserveJobHistory)</b>\n"
"<p>\n"
"Whether or not to preserve the job history after a\n"
"job is completed, canceled, or stopped.  Default is Yes.</p>\n"
"<p>\n"
"<i>ex</i>: Yes</p>\n"
msgstr ""
"<b>Yök ütkänlegen saqlaw (PreserveJobHistory)</b>\n"
"<p>\n"
"Bu köylämädä, yökneñ eşlängän/taşlanğan/tuqtatılğan buluınnan soñ, yök "
"ütkänlegen saqlaw kiräklege köylänä. Äytelmäsä, Yes dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: Yes</p>\n"

#: cupsd.conf.template.cpp:127
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Preserve job files (PreserveJobFiles)</b>\n"
"<p>\n"
"Whether or not to preserve the job files after a\n"
"job is completed, canceled, or stopped.  Default is No.</p>\n"
"<p>\n"
"<i>ex</i>: No</p>\n"
msgstr ""
"<b>Yök kötüen saqlaw (PreserveJobFiles)</b>\n"
"<p>\n"
"Bu köylämädä, yökneñ eşlängän/taşlanğan/tuqtatılğan buluınnan soñ, yök "
"biremnären saqlaw kiräklege köylänä. Äytelmäsä, No (yuq) dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: No</p>\n"

#: cupsd.conf.template.cpp:135
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Printcap file (Printcap)</b>\n"
"<p>\n"
"The name of the printcap file.  Default is no filename.\n"
"Leave blank to disable printcap file generation.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/printcap</p>\n"
msgstr ""
"<b>Basaqlar caylaw bireme (Printcap)</b>\n"
"<p>\n"
"Basaqlar caylawları belän biremneñ adı (printcap). Äytelmäsä, birem adı buş "
"qala. Şul biremne ürçetmäw öçen, bu köylämäne buş qaldırası.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /etc/printcap</p>\n"

#: cupsd.conf.template.cpp:143
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Request directory (RequestRoot)</b>\n"
"<p>\n"
"The directory where request files are stored.\n"
"By default /var/spool/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups</p>\n"
msgstr ""
"<b>Soraw törgäge (RequestRoot)</b>\n"
"<p>\n"
"Soraw biremnären saqlísı törgäk yulı.\n"
"Äytelmäsä, /var/spool/cups dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /var/spool/cups</p>\n"

#: cupsd.conf.template.cpp:151
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Remote root user (RemoteRoot)</b>\n"
"<p>\n"
"The name of the user assigned to unauthenticated accesses\n"
"from remote systems.  By default \"remroot\".</p>\n"
"<p>\n"
"<i>ex</i>: remroot</p>\n"
msgstr ""
"<b>Çittäge idäräçe (RemoteRoot)</b>\n"
"<p>\n"
"Çittän ireşep, tanılunı uzmağan qullanuçığa birelä torğan isem. Äytelmäsä, "
"\"remroot\" qullanıla.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: remroot</p>\n"

#: cupsd.conf.template.cpp:159
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Server binaries (ServerBin)</b>\n"
"<p>\n"
"The root directory for the scheduler executables.\n"
"By default /usr/lib/cups or /usr/lib32/cups (IRIX 6.5).</p>\n"
"<p>\n"
"<i>ex</i>: /usr/lib/cups</p>\n"
msgstr ""
"<b>Serverneñ eşçän biremnäre (ServerBin)</b>\n"
"<p>\n"
"Serverneñ eşçän biremnäre yatqan törgäk. Äytelmäsä, /usr/lib/cups dip sanala "
"(IRIX 6.5 astında /usr/lib32/cups).</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /usr/lib/cups</p>\n"

#: cupsd.conf.template.cpp:167
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Server files (ServerRoot)</b>\n"
"<p>\n"
"The root directory for the scheduler.\n"
"By default /etc/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups</p>\n"
msgstr ""
"<b>Server biremnäre (ServerRoot)</b>\n"
"<p>\n"
"CUPS server biremnäre öçen töp törgäk.\n"
"Äytelmäsä, /etc/cups dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /etc/cups</p>\n"

#: cupsd.conf.template.cpp:175
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>User (User)</b>\n"
"<p>\n"
"The user the server runs under.  Normally this\n"
"must be <b>lp</b>, however you can configure things for another user\n"
"as needed.</p>\n"
"<p>\n"
"Note: the server must be run initially as root to support the\n"
"default IPP port of 631.  It changes users whenever an external\n"
"program is run...</p>\n"
"<p>\n"
"<i>ex</i>: lp</p>\n"
msgstr ""
"<b>Qullanuçı (User)</b>\n"
"<p>\n"
"Server bu qullanuçı isemennän eşli. Ğädättä ul <b>lp</b> "
"dip sanala, läkin aña başqa isem dä quşıp bula.</p>\n"
"<p>\n"
"Ni beläse: 631. IPP portı aşa eşläp başlaw öçen, berençe cibärelü root "
"isemennän bulırğa tieş. Tışqı yazılım cibärelsä, anısı başqa isemennän eşlär "
"inde...</p>\n"
"<p>\n"
"<i>ü.ö.</i>: lp</p>\n"

#: cupsd.conf.template.cpp:188
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Group (Group)</b>\n"
"<p>\n"
"The group the server runs under.  Normally this\n"
"must be <b>sys</b>, however you can configure things for another\n"
"group as needed.</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"
msgstr ""
"<b>Törkem (Group)</b>\n"
"<p>\n"
"Server bu törkem äğzäse bularaq eşli. Ğädättä ul <b>sys</b> "
"dip sanala, läkin añı başqa törkemgä dä quyıp bula.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: sys</p>\n"

#: cupsd.conf.template.cpp:197
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>RIP cache (RIPCache)</b>\n"
"<p>\n"
"The amount of memory that each RIP should use to cache\n"
"bitmaps.  The value can be any real number followed by \"k\" for\n"
"kilobytes, \"m\" for megabytes, \"g\" for gigabytes, or \"t\" for tiles\n"
"(1 tile = 256x256 pixels).  Defaults to \"8m\" (8 megabytes).</p>\n"
"<p>\n"
"<i>ex</i>: 8m</p>\n"
msgstr ""
"<b>RIP alxätere (RIPCache)</b>\n"
"<p>\n"
"Sürätlärne alxäterläw öçen RIP'qa bireläçäk xäter küläme.\n"
"Anıñ bäyäsen kilobayt ('k' xärefe), megabayt ('m' xärefe), gigabayt ('g' "
"xärefe), yä tırnaq ('t' xärefe) belän ülçärgä bula. (1 tırnaq = 256x256 tap).\n"
"Äytelmäsä, '8m' (8 magabayt) dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 8m</p>\n"

#: cupsd.conf.template.cpp:207
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Temporary files (TempDir)</b>\n"
"<p>\n"
"The directory to put temporary files in. This directory must be\n"
"writable by the user defined above!  Defaults to \"/var/spool/cups/tmp\" or\n"
"the value of the TMPDIR environment variable.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups/tmp</p>\n"
msgstr ""
"<b>Çorlı biremnär (TempDir)</b>\n"
"<p>\n"
"Çorlı biremnär salu öçen törgäk bu. Elegräk bilgelängän qullanuçı öçen bu "
"törgäk yazırlıq bulırğa tieş!\n"
"Äytelmäsä, yä \"/var/spool/cups/tmp\", yä TMPDIR üzgärelmä bäyäsenä tiñ bulıp "
"sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: /var/spool/cups/tmp</p>\n"

#: cupsd.conf.template.cpp:216
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Filter limit (FilterLimit)</b>\n"
"<p>\n"
"Sets the maximum cost of all job filters that can be run\n"
"at the same time.  A limit of 0 means no limit.  A typical job may need\n"
"a filter limit of at least 200; limits less than the minimum required\n"
"by a job force a single job to be printed at any time.</p>\n"
"<p>\n"
"The default limit is 0 (unlimited).</p>\n"
"<p>\n"
"<i>ex</i>: 200</p>\n"
msgstr ""
"<b>Sözgeç çige (FilterLimit)</b>\n"
"<p>\n"
"Yök öçen beryulı cibärep bulğan sözgeçlärneñ bäyäse çikläwen bilgeli. Çikläwne "
"quymas öçen 0 kertäse.\n"
"Yöklärneñ kübese sözgeç bäyäseneñ iñ kimendä 200 buluın sorí; çikläw küläme yök "
"sorağanınnan da kim bulsa, ul yök ber üze genä basılaçaq dip uylana.</p>\n"
"<p>\n"
"Äytelmäsä, çik 0 bulıp sanala, yäğni çikläwsez.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 200</p>\n"

#: cupsd.conf.template.cpp:228
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Listen to (Port/Listen)</b>\n"
"<p>\n"
"Ports/addresses that are listened to.  The default port 631 is reserved\n"
"for the Internet Printing Protocol (IPP) and is what is used here.</p>\n"
"<p>\n"
"You can have multiple Port/Listen lines to listen to more than one\n"
"port or address, or to restrict access.</p>\n"
"<p>\n"
"Note: Unfortunately, most web browsers don't support TLS or HTTP Upgrades\n"
"for encryption.  If you want to support web-based encryption you will\n"
"probably need to listen on port 443 (the \"HTTPS\" port...).</p>\n"
"<p>\n"
"<i>ex</i>: 631, myhost:80, 1.2.3.4:631</p>\n"
msgstr ""
"<b>Tıñlana (Port/Listen)</b>\n"
"<p>\n"
"Bu port/adreslärne tıñlísı. Ğädättä 631. port qullanıla, ul Internet Printing "
"Protocol (IPP) öçen totılğan dip sanala.</p>\n"
"<p>Berniçä server tıñlaw öçen, yä ireşüne çikläw öçen, monda berniçä yul kertep "
"bula.</p>\n"
"<p>Beläse: web-gizgeçlärneñ kübese TLS ta, HTTP serläwçe yañartmalarnı da "
"totmílar.  Şuña kürä, web aşa serläwne totu öçen, 443. portnı tıñlarğa quyıp "
"bula, yäğni HTTPS portın qullanıp.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 631, hostim:80, 1.2.3.4:631</p>\n"

#: cupsd.conf.template.cpp:243
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Hostname lookups (HostNameLookups)</b>\n"
"<p>\n"
"Whether or not to do lookups on IP addresses to get a\n"
"fully-qualified hostname.  This defaults to Off for performance reasons...</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>Host adın ezläw (HostNameLookups)</b>\n"
"<p>\n"
"Host adın anıñ IP buyınça ezläwne cibärä. Citezlek kimetmäw maqsatınnan, "
"ğädättä ul \"Off\" yäğni sünek bulıp tora...</p>\n"
"<p>\n"
"<i>ü.ö.</i>: On</p>\n"

#: cupsd.conf.template.cpp:251
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Keep alive (KeepAlive)</b>\n"
"<p>\n"
"Whether or not to support the Keep-Alive connection\n"
"option.  Default is on.</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>Tere totu (KeepAlive)</b>\n"
"<p>\n"
"Totaşularnı \"Keep-Alive\" yäğni tere itep totu mömkinlegen açuçı köylämä bu. "
"Äytelmäsä, açıq bulıp sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: On</p>\n"

#: cupsd.conf.template.cpp:259
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Keep-alive timeout (KeepAliveTimeout)</b>\n"
"<p>\n"
"The timeout (in seconds) before Keep-Alive connections are\n"
"automatically closed.  Default is 60 seconds.</p>\n"
"<p>\n"
"<i>ex</i>: 60</p>\n"
msgstr ""
"<b>Tere-totu arası (KeepAliveTimeout)</b>\n"
"<p>\n"
"Açıq totaşunı yapqançı sekundlap ülçängän kötü arası. Äytelmäsä, 60 sekund dip "
"sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 60</p>\n"

#: cupsd.conf.template.cpp:267
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Max clients (MaxClients)</b>\n"
"<p>\n"
"Controls the maximum number of simultaneous clients that\n"
"will be handled.  Defaults to 100.</p>\n"
"<p>\n"
"<i>ex</i>: 100</p>\n"
msgstr ""
"<b>Klient sanı (MaxClients)</b>\n"
"<p>\n"
"Ber yulı eşlägän klient sanın çikläw. Äytelmäsä, 100 dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 100</p>\n"

#: cupsd.conf.template.cpp:275
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Max request size (MaxRequestSize)</b>\n"
"<p>\n"
"Controls the maximum size of HTTP requests and print files.\n"
"Set to 0 to disable this feature (defaults to 0).</p>\n"
"<p>\n"
"<i>ex</i>: 0</p>\n"
msgstr ""
"<b>Soraw külämen çikläw (MaxRequestSize)</b>\n"
"<p>\n"
"HTTP sorawlar belän pastıru biremnäreneñ külämen çikläw. Anı sünderü öçen 0 "
"itep quyası. Äytelmäsä, 0 dip sanala.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 0</p>\n"

#: cupsd.conf.template.cpp:283
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Client timeout (Timeout)</b>\n"
"<p>\n"
"The timeout (in seconds) before requests time out.  Default is 300 seconds.</p>"
"\n"
"<p>\n"
"<i>ex</i>: 300</p>\n"
msgstr ""
"<b>Klientne kötü (Timeout)</b>\n"
"<p>\n"
"Klient yağınnan soraw kötü arası (sekund sanı). Äytelmäsä, 300 sekund dip "
"sanala.</p>\n"
"<p>\n"
"<i>ü.ö</i>: 300</p>\n"

#: cupsd.conf.template.cpp:290
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Use browsing (Browsing)</b>\n"
"<p>\n"
"Whether or not to <b>listen</b> to printer \n"
"information from other CUPS servers.  \n"
"</p>\n"
"<p>\n"
"Enabled by default.\n"
"</p>\n"
"<p>\n"
"Note: to enable the <b>sending</b> of browsing\n"
"information from this CUPS server to the LAN,\n"
"specify a valid <i>BrowseAddress</i>.\n"
"</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>Küzätüne qullanu (Browsing)</b>\n"
"<p>Başqa CUPS serverlärdäge basaqlar turında tıñlarğamı/yuqmı, şunısın "
"bilgeli.</p>\n"
"<p>Ğädättä açıq bulıp sanala.</p>\n"
"<p>\n"
"Beläse: bu CUPS-server xäläte turında belemne çeltär aşa <b>cibärü</b> "
"öçen,yaraqlı <i>BrowseAddress</i> bilgelärgä kiräk.\n"
"</p>\n"
"<p><i>ü.ö.</i>: On</p>\n"

#: cupsd.conf.template.cpp:307
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Use short names (BrowseShortNames)</b>\n"
"<p>\n"
"Whether or not to use \"short\" names for remote printers\n"
"when possible (e.g. \"printer\" instead of \"printer@host\").  Enabled by\n"
"default.</p>\n"
"<p>\n"
"<i>ex</i>: Yes</p>\n"
msgstr ""
"<b>Qısqa isem qullanu (BrowseShortNames)</b>\n"
"<p>\n"
"Çit basaq adınıñ \"qısqa\" tören qullanu mömkinlege açıluın bilgeli. (ü.ö. "
"\"basaq@host\" urınına \"basaq\" itep tä). Äytelmäsä, bu mömkinlek açıq.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: Yes</p>\n"

#: cupsd.conf.template.cpp:316
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse addresses (BrowseAddress)</b>\n"
"<p>\n"
"Specifies a broadcast address to be used.  By\n"
"default browsing information is broadcast to all active interfaces.</p>\n"
"<p>\n"
"Note: HP-UX 10.20 and earlier do not properly handle broadcast unless\n"
"you have a Class A, B, C, or D netmask (i.e. no CIDR support).</p>\n"
"<p>\n"
"<i>ex</i>: x.y.z.255, x.y.255.255</p>\n"
msgstr ""
"<b>Küzätü adresläre (BrowseAddress)</b>\n"
"<p>\n"
"Tapşıru adreslären bilgeli. Ğädättä, küzätü beleme bar bulğan açıq yözaralar "
"aşa tapşırıla.</p>\n"
"<p>\n"
"Beläse: HP-UX 10.20 söremenä tikle, anda CIDR totu bulmağaç, bu mömkinlekneñ "
"A/B/C/D sıynıflı çeltär aşa döres eşlämäwe bar.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: x.y.z.255, x.y.255.255</p>\n"

#: cupsd.conf.template.cpp:327
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse allow/deny (BrowseAllow/BrowseDeny)</b>\n"
"<p>\n"
"<u>BrowseAllow</u>: specifies an address mask to allow for incoming browser\n"
"packets. The default is to allow packets from all addresses.</p>\n"
"<p>\n"
"<u>BrowseDeny</u>: specifies an address mask to deny for incoming browser\n"
"packets. The default is to deny packets from no addresses.</p>\n"
"<p>\n"
"Both \"BrowseAllow\" and \"BrowseDeny\" accept the following notations for\n"
"addresses:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre>"
"<p>\n"
"The hostname/domainname restrictions only work if you have turned hostname\n"
"lookups on!</p>\n"
msgstr ""
"<b>Küzätep bula/yaramí (BrowseAllow/BrowseDeny)</b>\n"
"<p>\n"
"<u>BrowseAllow</u>: kilgän küzätü sorawları öçen yaraqlı adres sözgeçen "
"bilgeli. Ğädättä, bar adreslär dä yaraqlı.</p>\n"
"<p>\n"
"<u>BrowseDeny</u>: kilgän küzätü sorawları öçen tıyılğan adres sözgeçen "
"bilgeli. Ğädättä, tıyılğan adreslär yuq.</p>\n"
"<p>\n"
"\"BrowseAllow\" da, \"BrowseDeny\" da kertelgän adreslärne bolaraq kötä:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre>"
"<p>\n"
"Host adın ezläw açıq bulsa ğına, host/domain adı buyınça çikläp bula!</p>\n"

#: cupsd.conf.template.cpp:354
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse interval (BrowseInterval)</b>\n"
"<p>\n"
"The time between browsing updates in seconds.  Default\n"
"is 30 seconds.</p>\n"
"<p>\n"
"Note that browsing information is sent whenever a printer's state changes\n"
"as well, so this represents the maximum time between updates.</p>\n"
"<p>\n"
"Set this to 0 to disable outgoing broadcasts so your local printers are\n"
"not advertised but you can still see printers on other hosts.</p>\n"
"<p>\n"
"<i>ex</i>: 30</p>\n"
msgstr ""
"<b>Küzätü arası (BrowseInterval)</b>\n"
"<p>\n"
"Küzätü sorawları arasında torıp toru sekund sanı. Äytelmäsä,30 sekund dip "
"sanala.</p>\n"
"<p>\n"
"Beläse: küzätü beleme, basaq xäläte üzgärelgändä cibärelä, şulay itep, biredäge "
"bäyä yañartu arasınıñ öske çigen bilgeli.</p>\n"
"<p>\n"
"Bäyäne 0 quyıp, küzätü tapşıruların sünderä, ulay itep cirle sanağıñ üz xäläte "
"turında çeltär buylap belderep tormas, läkin başqa basaqlarnıñ xäläten kürep "
"bulır.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 30</p>\n"

#: cupsd.conf.template.cpp:368
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse order (BrowseOrder)</b>\n"
"<p>\n"
"Specifies the order of BrowseAllow/BrowseDeny comparisons.</p>\n"
"<p>\n"
"<i>ex</i>: allow,deny</p>\n"
msgstr ""
"<b>Küzätü tärtibe (BrowseOrder)</b>\n"
"<p>\n"
"BrowseAllow/BrowseDeny şartların çağıştıru tärtiben bilgeli.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: allow,deny</p>\n"

#: cupsd.conf.template.cpp:375
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse poll (BrowsePoll)</b>\n"
"<p>\n"
"Poll the named server(s) for printers.</p>\n"
"<p>\n"
"<i>ex</i>: myhost:631</p>\n"
msgstr ""
"<b>Küzätü isemlege (BrowsePoll)</b>\n"
"<p>\n"
"Basaq serverläre belän isemlek.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: hostim:631</p>\n"

#: cupsd.conf.template.cpp:382
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse port (BrowsePort)</b>\n"
"<p>\n"
"The port used for UDP broadcasts.  By default this is\n"
"the IPP port; if you change this you need to do it on all servers.\n"
"Only one BrowsePort is recognized.</p>\n"
"<p>\n"
"<i>ex</i>: 631</p>\n"
msgstr ""
"<b>Küzätü portı (BrowsePort)</b>\n"
"<p>\n"
"UDP tapşıru öçen qullanılğan port. Äytelmäsä, IPP portı qullanaçaq; ägär anı "
"üzgärtäseñ ikän, anı bar serverlärda dä üzgärtäse bulır.\n"
"Ber genä BrowsePort quyıp bula.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: 631</p>\n"

#: cupsd.conf.template.cpp:391
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse relay (BrowseRelay)</b>\n"
"<p>\n"
"Relay browser packets from one address/network to another.</p>\n"
"<p>\n"
"<i>ex</i>: src-address dest-address</p>\n"
msgstr ""
"<b>Küzätüne yünältü (BrowseRelay)</b>\n"
"<p>\n"
"Küzätü sorawların ber çeltär/adrestän ikençegä yünältü.</p>\n"
"<p>\n"
"<i>ü.ö.</i>: çığanaq-adrese maqsat-adrese</p>\n"

#: cupsd.conf.template.cpp:398
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse timeout (BrowseTimeout)</b>\n"
"<p>\n"
"The timeout (in seconds) for network printers - if we don't\n"
"get an update within this time the printer will be removed\n"
"from the printer list.  This number definitely should not be\n"
"less the BrowseInterval value for obvious reasons.  Defaults\n"
"to 300 seconds.</p>\n"
"<p>\n"
"<i>ex</i>: 300</p>\n"
msgstr ""
"<b>Küzätüne kütü arası (BrowseTimeout)</b>\n"
"<p>\n"
"Çeltärle basaqlarnı kötü arası (sekundlap) – şul ara betkänçe basaqtan xäbär "
"kilmäsä, ul basaq isemlektän töşerelä. Añlaşıla ki, bu köylämäneñ bäyäse küzätü "
"arası bäyäsennän dä kim bula almí. Äytelmäsä, ul 300 sekund dip sanala."
"<p>\n"
"<i>ü.ö.</i>: 300</p>\n"

#: cupsd.conf.template.cpp:409
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Implicit classes (ImplicitClasses)</b>\n"
"<p>\n"
"Whether or not to use implicit classes.</p>\n"
"<p>\n"
"Printer classes can be specified explicitly in the classes.conf\n"
"file, implicitly based upon the printers available on the LAN, or\n"
"both.</p>\n"
"<p>\n"
"When ImplicitClasses is On, printers on the LAN with the same name\n"
"(e.g. Acme-LaserPrint-1000) will be put into a class with the same\n"
"name. This allows you to setup multiple redundant queues on a LAN\n"
"without a lot of administrative difficulties.  If a user sends a\n"
"job to Acme-LaserPrint-1000, the job will go to the first available\n"
"queue.</p>\n"
"<p>\n"
"Enabled by default.</p>\n"
msgstr ""
"<b>Anıqsız sıynıflar (ImplicitClasses)</b>\n"
"<p>\n"
"Anıqsız sıynıflarnı qullanasımı, yuqmı.</p>\n"
"<p>\n"
"Basaq sıynıfları classes.conf biremenä kertelä.</p>\n"
"<p>\n"
"Anıqsız sıynıflar qullanu açıq ikän (\"On\"), çeltärdä ber ük isem belän "
"kürengän basaqlar, şul isem kergän sıynıfqa kerteläçäk. Şulay itep, berär "
"qullanuçı üzeneñ bastıru yögen basaqlarnıñ berär sıynıfına cibärä ikän, ul yök "
"şul sıynıfqa kergän buş basaqlarnıñ berençesenä kitäçäk.</p>\n"
"<p>\n"
"Ğädättä bu köylämä açıq tora.</p>\n"

#: cupsd.conf.template.cpp:427
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>System group (SystemGroup)</b>\n"
"<p>\n"
"The group name for \"System\" (printer administration)\n"
"access.  The default varies depending on the operating system, but\n"
"will be <b>sys</b>, <b>system</b>, or <b>root</b> (checked for in that "
"order).</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"
msgstr ""
"<b>Sistem törkeme (SystemGroup)</b>\n"
"<p>\n"
"Basaq idäräçeläre öçen törkem adı. Ğädättä anıñ adı quylığan sistemenä bäyle; \n"
"<b>sys</b>, <b>system</b>, yä <b>root</b> itep bula ala.</p>\n"
"<p><i>ü.ö.</i>: sys</p>\n"

#: cupsd.conf.template.cpp:436
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Encryption certificate (ServerCertificate)</b>\n"
"<p>\n"
"The file to read containing the server's certificate.\n"
"Defaults to \"/etc/cups/ssl/server.crt\".</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.crt</p>\n"
msgstr ""
"<b>Serläw tanıqlığı (ServerCertificate)</b>\n"
"<p>\n"
"Serverneñ tanıqlıqları belän birem.\n"
"Äytelmäsä, ul \"/etc/cups/ssl/server.crt\" dip sanala.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.crt</p>\n"

#: cupsd.conf.template.cpp:444
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Encryption key (ServerKey)</b>\n"
"<p>\n"
"The file to read containing the server's key.\n"
"Defaults to \"/etc/cups/ssl/server.key\".</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.key</p>\n"
msgstr ""
"<b>Serläw açqıçı (ServerKey)</b>\n"
"<p>\n"
"Serverneñ açqıçları belän birem.\n"
"Äytelmäsä, ul \"/etc/cups/ssl/server.key\" dip sanala.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.key</p>\n"

#: cupsd.conf.template.cpp:452
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"Access permissions\n"
"# Access permissions for each directory served by the scheduler.\n"
"Locations are relative to DocumentRoot...\n"
"# AuthType: the authorization to use:\n"
"#    None   - Perform no authentication\n"
"Basic  - Perform authentication using the HTTP Basic method.\n"
"Digest - Perform authentication using the HTTP Digest method.\n"
"#    (Note: local certificate authentication can be substituted by\n"
"the client for Basic or Digest when connecting to the\n"
"localhost interface)\n"
"# AuthClass: the authorization class; currently only Anonymous, User,\n"
"System (valid user belonging to group SystemGroup), and Group\n"
"(valid user belonging to the specified group) are supported.\n"
"# AuthGroupName: the group name for \"Group\" authorization.\n"
"# Order: the order of Allow/Deny processing.\n"
"# Allow: allows access from the specified hostname, domain, IP address, or\n"
"network.\n"
"# Deny: denies access from the specified hostname, domain, IP address, or\n"
"network.\n"
"# Both \"Allow\" and \"Deny\" accept the following notations for addresses:\n"
"#     All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"# The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.\n"
"# Encryption: whether or not to use encryption; this depends on having\n"
"the OpenSSL library linked into the CUPS library and scheduler.\n"
"# Possible values:\n"
"#     Always       - Always use encryption (SSL)\n"
"Never        - Never use encryption\n"
"Required     - Use TLS encryption upgrade\n"
"IfRequested  - Use encryption if the server requests it\n"
"# The default value is \"IfRequested\".\n"
msgstr ""
"İreşü xoquqları\n"
"# Server eşendä qullanılğan törgäklär öçen xoquqlar.\n"
"Urınlaşular DocumentRoot törgägennän tayana...\n"
"# AuthType: tanılu ısulı:\n"
"#    None   - Tanılusız\n"
"Basic  - HTTP Basic ısulı belän tanılu.\n"
"Digest - HTTP Digest ısulı belän tanılu.\n"
"#    (Beläse: cirle tanıqlıq belän Basic/Digest aşa tanılunı,\n"
"localhost yözarası aşa totaşqan klientlärgä genä qullanıp bula)\n"
"# AuthClass: tanılu törlege; biredä Anonymous, User,\n"
"System (SystemGroup törkemeneñ äğzäse) dä, Group\n"
"(AuthGroup törkemeneñ äğzäse) ğına kertep bula.\n"
"# AuthGroupName: \"Group\" kebek tanılu öçen törkem adı.\n"
"# Order: Allow/Deny eşkärtü tärtibe.\n"
"# Allow: kertelgän host, domain, IP adres, yä çeltärdän ireşüne aça.\n"
"# Deny: kertelgän host, domain, IP adres, yä çeltärdän ireşüne yaba.\n"
"# \"Allow\" da, \"Deny\" da, adreslärneñ kiläsençä kertelüen kötä:\n"
"#     All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"# \"HostNameLookups On\" köylämäse açıq bulsa ğına,\n"
"host/domain adın kertep bula.\n"
"# Encryption: serläwne qullanasımı; CUPS servere OpenSSL tuplaması\n"
"belän cıyılğan bulsa ğına, bu köylämäne qullanırğa yarí.\n"
"# Yaraqlı bäyälär:\n"
"#     Always       - SSL-serläw belän\n"
"Never        - Serläwne qullanmasqa\n"
"Required     - TLS-serläw belän\n"
"IfRequested  - Server sorasa ğına qullanası\n"
"# Äytelmäsä, \"IfRequested\" kertelgän dip sanala.\n"

#: cupsd.conf.template.cpp:495
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Authentication (AuthType)</b>\n"
"<p>\n"
"The authorization to use:"
"<p>\n"
"<ul type=circle>\n"
"<li><i>None</i>   - Perform no authentication.</li>\n"
"<li><i>Basic</i>  - Perform authentication using the HTTP Basic method.</li>\n"
"<li><i>Digest</i> - Perform authentication using the HTTP Digest method.</li>\n"
"</ul>"
"<p>\n"
"Note: local certificate authentication can be substituted by\n"
"the client for <i>Basic</i> or <i>Digest</i> when connecting to the\n"
"localhost interface.</p>\n"
msgstr ""
"<b>Tanılu ısulı (AuthType)</b>\n"
"<p>\n"
"Tanılu ısulları:"
"<p>\n"
"<ul type=circle>\n"
"<li><i>None</i>  - Tanılu qullanılmí.</li>\n"
"<li><i>Basic</i> - HTTP Basic ısulı belän tanılu.</li>\n"
"<li><i>Digest</i> - HTTP Digest ısulı belän tanılu.</li>\n"
"</ul>"
"<p>\n"
"Beläse: cirle tanıqlıq belän <i>Basic/Digest</i> ısulı belän tanılunı,\n"
"localhost yözarası aşa totaşqan klientlärgä genä qullanıp bula</p>\n"

#: cupsd.conf.template.cpp:508
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Class (AuthClass)</b>\n"
"<p>\n"
"The authorization class; currently only <i>Anonymous</i>, <i>User</i>,\n"
"<i>System</i> (valid user belonging to group SystemGroup), and <i>Group</i>\n"
"(valid user belonging to the specified group) are supported.</p>\n"
msgstr ""
"<b>Tanılu töre (AuthClass)</b>\n"
"<p>\n"
"Tanılu törlege bu; biredä <i>Anonymous</i>, <i>User</i>, <i>System</i> "
"(SystemGroup törkemeneñ äğzäse) dä, <i>Group</i> (AuthGroup törkemeneñ äğzäse) "
"ğına kertep bula.</p>\n"

#: cupsd.conf.template.cpp:515
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<p>The user/group names allowed to access the resource. The format is a\n"
"comma separated list.</p>\n"
msgstr ""
"<p>Bu resursqa ireşä alğan qullanuçı/törkem tezmäse. Öter belän aralaştırıp "
"kertäse.</p>\n"

#: cupsd.conf.template.cpp:519
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Satisfy (Satisfy)</b>\n"
"<p>\n"
"This directive controls whether all specified conditions must\n"
"be satisfied to allow access to the resource. If set to \"all\",\n"
"then all authentication and access control conditions must be\n"
"satisfied to allow access.\n"
"</p>\n"
"<p>\n"
"Setting Satisfy to \"any\" allows a user to gain access if the\n"
"authentication <i>or</i> access control requirements are satisfied.\n"
"For example, you might require authentication for remote access,\n"
"but allow local access without authentication.\n"
"</p>\n"
"<p>\n"
"The default is \"all\".\n"
"</p> \n"
msgstr ""
"<b>Täläplär (Satisfy)</b>\n"
"<p>\n"
"Bu köylämädä, resursqa ireşü şartlarınıñ tikşerenüen bilgeli. Ägär \"all\" itep "
"köylängän ikän, dimäk şartlarnıñ barısı da ütälsä genä ireşü açıq bulaçaq.\n"
"</p>\n"
"<p>\n"
"Ägär täläplär \"any\" itep köylängän ikän, dimäk bulğan şartlarnıñ berse genä "
"dä ütälsä, ireşü açıq bulaçaq. Ürnäk öçen, çittän ireşü öçen tanılunı ütterergä "
"bula, cirle ireşü öçen isä tanılusız da bula.\n"
"</p>\n"
"<p>\n"
"Äytelmäsä, \"all\" dip sanala.\n"
"</p> \n"

#: cupsd.conf.template.cpp:537
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Authentication group name (AuthGroupName)</b>\n"
"<p>\n"
"The group name for <i>Group</i> authorization.</p>\n"
msgstr ""
"<b>Tanılu törkemeneñ adı (AuthGroupName)</b>\n"
"<p>\n"
"<i>Group</i> aşa tanıluçı törkemeneñ adı.</p>\n"

#: cupsd.conf.template.cpp:542
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>ACL order (Order)</b>\n"
"<p>\n"
"The order of Allow/Deny processing.</p>\n"
msgstr ""
"<b>ACL tärtibe (Order)</b>\n"
"<p>\n"
"Allow/Deny eşkärtü tärtibe.</p>\n"

#: cupsd.conf.template.cpp:547
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Allow</b>\n"
"<p>\n"
"Allows access from the specified hostname, domain, IP address, or\n"
"network. Possible values are:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre>"
"<p>\n"
"The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.</p>\n"
msgstr ""
"<b>Allow</b>\n"
"<p>\n"
"Kertelgän host, domain, IP adres, yä çeltär öçen ireşüne aça. Kertep bulğan "
"bäyälär:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre>"
"<p>\n"
"\"HostNameLookups On\" köylämäse açıq bulsa ğına,host/domain adın kertep "
"bula.</p>\n"

#: cupsd.conf.template.cpp:568
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>ACL addresses (Allow/Deny)</b>\n"
"<p>\n"
"Allows/Denies access from the specified hostname, domain, IP address, or\n"
"network. Possible values are:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre>"
"<p>\n"
"The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.</p>\n"
msgstr ""
"<b>ACL adresläre</b>\n"
"<p>\n"
"Kertelgän host, domain, IP adres, yä çeltär öçen ireşüne açıp/yabıp quyu. "
"Kertep bulğan bäyälär:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre>"
"<p>\n"
"\"HostNameLookups On\" köylämäse açıq bulsa ğına,host/domain adın kertep "
"bula.</p>\n"

#: cupsd.conf.template.cpp:589
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Encryption (Encryption)</b>\n"
"<p>\n"
"Whether or not to use encryption; this depends on having\n"
"the OpenSSL library linked into the CUPS library and scheduler.</p>\n"
"<p>\n"
"Possible values:</p>\n"
"<ul type=circle>\n"
"<li><i>Always</i>       - Always use encryption (SSL)</li>\n"
"<li><i>Never</i>        - Never use encryption</li>\n"
"<li><i>Required</i>     - Use TLS encryption upgrade</li>\n"
"<li><i>IfRequested</i>  - Use encryption if the server requests it</li>\n"
"</ul>"
"<p>\n"
"The default value is \"IfRequested\".</p>\n"
msgstr ""
"<b>Serläw (Encryption)</b>\n"
"<p>\n"
"Serläwne qullanasımı, yuqmı; CUPS servere OpenSSL tuplaması\n"
"belän cıyılğan bulsa ğına, bu köylämäne qullanırğa yarí.\n"
"</p>\n"
"<p>\n"
" Yaraqlı bäyälär:</p>\n"
"<ul type=circle>\n"
"<li><i>Always</i>       - SSL-serläw belän</li>\n"
"<li><i>Never</i>        - Serläwne qullanmasqa</li>\n"
"<li><i>Required</i>     - TLS-serläw belän</li>\n"
"<li><i>IfRequested</i>  - Server sorasa ğına qullanası</li>\n"
"</ul>"
"<p>\n"
"Äytelmäsä, \"IfRequested\" kertelgän dip sanala.</p>\n"

#: cupsd.conf.template.cpp:604
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Access permissions</b>\n"
"<p>\n"
"Access permissions for each directory served by the scheduler.\n"
"Locations are relative to DocumentRoot...</p>\n"
msgstr ""
"<b>İreşü xoquqları</b>\n"
"<p>\n"
"Server eşendä qullanılğan törgäklär öçen xoquqlar.\n"
"Urınlaşular DocumentRoot törgägennän tayana...\n"
"</p>\n"

#: cupsd.conf.template.cpp:610
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Auto purge jobs (AutoPurgeJobs)</b>\n"
"<p>\n"
"Automatically purge jobs when not needed for quotas.\n"
"Default is No.</p>\n"
msgstr ""
"<b>Yöklärdän buşatılu (AutoPurgeJobs)</b>\n"
"<p>\n"
"Qullanu çiklären isäpläw öçen kiräk bulmasa, yöklärdän buşatılıp toraçaq.\n"
"ÄYtelmäsä, \"No\" dip sanala.</p>\n"

#: cupsd.conf.template.cpp:616
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Browse protocols (BrowseProtocols)</b>\n"
"<p>\n"
"Which protocols to use for browsing.  Can be\n"
"any of the following separated by whitespace and/or commas:</p>\n"
"<ul type=circle>\n"
"<li><i>all</i>  - Use all supported protocols.</li>\n"
"<li><i>cups</i> - Use the CUPS browse protocol.</li>\n"
"<li><i>slp</i>  - Use the SLPv2 protocol.</li>\n"
"</ul>"
"<p>\n"
"The default is <b>cups</b>.</p>\n"
"<p>\n"
"Note: If you choose to use SLPv2, it is <b>strongly</b> recommended that\n"
"you have at least one SLP Directory Agent (DA) on your\n"
"network.  Otherwise, browse updates can take several seconds,\n"
"during which the scheduler will not response to client\n"
"requests.</p>\n"
msgstr ""
"<b>Küzätü protokolları (BrowseProtocols)</b>\n"
"<p>\n"
"Küzätü öçen qullanılğan protokollar. Buşlıq/öterlär belän ayırıp, boların "
"kertep bula:</p>\n"
"<ul type=circle>\n"
"<li><i>all</i>  - Totılğan protokollarnıñ barısın da.</li>\n"
"<li><i>cups</i> - CUPS küzätü protokolın.</li>\n"
"<li><i>slp</i>  - SLPv2 protokolı.</li>\n"
"</ul>"
"<p>\n"
"Äytelmäsä, <b>cups</b> kertelgän dip sanala.</p>\n"
"<p>\n"
"Beläse: Qullanu öçen SLPv2 saylanğan ikän, çeltäreñdä iñ kimendä ber SLP-törkäk "
"agente (SLP Directory Agent, DA) buluı <b>bik</b> kiñäş itelä. Yä isä, küzätüne "
"yañartu öçen berniçä sekund kitüe bar.</p>\n"

#: cupsd.conf.template.cpp:634
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Classification (Classification)</b>\n"
"<p>\n"
"The classification level of the server.  If set, this\n"
"classification is displayed on all pages, and raw printing is disabled.\n"
"The default is the empty string.</p>\n"
"<p>\n"
"<i>ex</i>: confidential\n"
msgstr ""
"<b>Törlekläw (Classification)</b>\n"
"<p>\n"
"Serverneñ törlekläw däräcäse. Quyılğan bulsa, basılaçaq bitlärneñ barısında bu "
"törlekläw yazması çığaralaçaq, turı/taqır bastıru isä sündereläçäk.\n"
"Äytelmäsä, buş bulıp sanala.</p>\n"
"<p>\n"
"<i>ex</i>: xosusí\n"

#: cupsd.conf.template.cpp:643
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Allow overrides (ClassifyOverride)</b>\n"
"<p>\n"
"Whether to allow users to override the classification\n"
"on printouts. If enabled, users can limit banner pages to before or\n"
"after the job, and can change the classification of a job, but cannot\n"
"completely eliminate the classification or banners.</p>\n"
"<p>\n"
"The default is off.</p>\n"
msgstr ""
"<b>Almaştırunı açu (ClassifyOverride)</b>\n"
"<p>\n"
"Qullanuçığa basılaçaq äyberneñ törlekläwen almaştırırğa xoquq birü.Açıq bulsa, "
"bastıru yöge aldınnan/soñınnan basılaçaq törlekläw yazması belän ayırğıç-bit "
"eçtälegen qullanuçı üze üzgärtä alaçaq, läkin törlekläw bitennän bötenläy ul "
"barıber qotıla alamas.</p>\n"
"<p>\n"
"Äytelmäsä, sünek dip sanala.</p>\n"

#: cupsd.conf.template.cpp:653
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Hide implicit members (HideImplicitMembers)</b>\n"
"<p>\n"
"Whether or not to show the members of an\n"
"implicit class.</p>\n"
"<p>\n"
"When HideImplicitMembers is On, any remote printers that are\n"
"part of an implicit class are hidden from the user, who will\n"
"then only see a single queue even though many queues will be\n"
"supporting the implicit class.</p>\n"
"<p>\n"
"Enabled by default.</p>\n"
msgstr ""
"<b>Anıqsız äğzälärne yäşerü (HideImplicitMembers)</b>\n"
"<p>\n"
"Anıqsız sıynıf äğzälaren yäşerüen bilgeli.</p>\n"
"<p>\n"
"Bu köylämäneñ açıq bulğanda, anıqsız sıynıfqa kergän basaqlar qullanuçıdan "
"yäşerelep torırlar, anısı isä ber genä näwbätne kürä alaçaq, anıqsız sıynıf "
"berniçä näwbätne tota alsa da.</p>\n"
"<p>\n"
"Äytelmäsä, açıq dip sanala.</p>\n"

#: cupsd.conf.template.cpp:666
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Use &quot;any&quot; classes (ImplicitAnyClasses)</b>\n"
"<p>\n"
"Whether or not to create <b>AnyPrinter</b> implicit\n"
"classes.</p>\n"
"<p>\n"
"When ImplicitAnyClasses is On and a local queue of the same name\n"
"exists, e.g. \"printer\", \"printer@server1\", \"printer@server1\", then\n"
"an implicit class called \"Anyprinter\" is created instead.</p>\n"
"<p>\n"
"When ImplicitAnyClasses is Off, implicit classes are not created\n"
"when there is a local queue of the same name.</p>\n"
"<p>\n"
"Disabled by default.</p>\n"
msgstr ""
"<b>\"Törle\" sıynıfın qullanu (ImplicitAnyClasses)</b>\n"
"<p>\n"
"Bu köylämä <b>AnyPrinter</b> (Törle Basaq) atlı sıynıfnıñ yasaluın bilgeli.</p>"
"\n"
"<p>\n"
"ImplicitAnyClasses köylämäse \"On\" itep köylängän bulğanda, şulay uq atalğan "
"cirle näwbät tä bulsa (ü.ö. \"printer\", \"printer@server1\"), ul çaqta anıñ "
"urınına \"Anyprinter\" atlı anıqsız sıynıf yasılaçaq.</p>\n"
"<p>\n"
"ImplicitAnyClasses köylämäse \"Off\" itep köylängän ikän, ul çaqta anıqsız "
"sıynıf yasalmí.</p>\n"
"<p>\n"
"Äytelmäsä, sünek dip sanala.</p>\n"

#: cupsd.conf.template.cpp:681
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Max jobs (MaxJobs)</b>\n"
"<p>\n"
"Maximum number of jobs to keep in memory (active and completed).\n"
"Default is 0 (no limit).</p>\n"
msgstr ""
"<b>Yök sanın çikläw (MaxJobs)</b>\n"
"<p>\n"
"Xäterdä saqlísı bastıru yökläreneñ sanın çikläw (kötkännäre dä, bulğannarı "
"da).\n"
"Äytelmäsä, 0 dip sanala (çikläwsez).</p>\n"

#: cupsd.conf.template.cpp:687
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Max jobs per user (MaxJobsPerUser)</b>\n"
"<p>\n"
"The MaxJobsPerUser directive controls the maximum number of <i>active</i>\n"
"jobs that are allowed for each user. Once a user reaches the limit, new\n"
"jobs will be rejected until one of the active jobs is completed, stopped,\n"
"aborted, or canceled.</p>\n"
"<p>\n"
"Setting the maximum to 0 disables this functionality.\n"
"Default is 0 (no limit).\n"
"</p>\n"
msgstr ""
"<b>Qullanuçı sayın yök sanı (MaxJobsPerUser)</b>\n"
"<p>\n"
"MaxJobsPerUser köylämäse, qullanuçıdan bulğan <i>bastırası</i> "
"yök sanın çikli. Qullanuçı ul çikne citte ikän, <i>bastırası</i> "
"yöklär eşkärtkän/tuqtatılğan/beterelgän bulğannan soñ ğına yaña yöklärne "
"cibärep bulaçaq.</p>\n"
"<p>\n"
"Çikne 0 itep quyu, şul çikläwne beteräçäk.\n"
"Äytelmäsä, 0 dip sanala (çikläwsez).\n"
"</p>\n"

#: cupsd.conf.template.cpp:699
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Max jobs per printer (MaxJobsPerPrinter)</b>\n"
"<p>\n"
"The MaxJobsPerPrinter directive controls the maximum number of <i>active</i>\n"
"jobs that are allowed for each printer or class. Once a printer or class\n"
"reaches the limit, new jobs will be rejected until one of the active jobs\n"
"is completed, stopped, aborted, or canceled.</p>\n"
"<p>\n"
"Setting the maximum to 0 disables this functionality.\n"
"Default is 0 (no limit).\n"
"</p>\n"
msgstr ""
"<b>Basaq sayın yök sanı (MaxJobsPerPrinter)</b>\n"
"<p>\n"
"MaxJobsPerPrinter köylämäse, basaq/sıynıfta bulğan <i>bastırası</i> "
"yök sanın çikli. Ägär basaq/sıynıf ul çikne citte ikän, <i>bastırası</i> "
"yöklär eşkärtkän/tuqtatılğan/beterelgän bulğannan soñ ğına yaña yöklärne "
"cibärep bulaçaq.</p>\n"
"<p>\n"
"Çikne 0 itep quyu, şul çikläwne beteräçäk.\n"
"Äytelmäsä, 0 dip sanala (çikläwsez).\n"

#: cupsd.conf.template.cpp:711
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Port</b>\n"
"<p>\n"
"The port value that the CUPS daemon is listening to. Default is 631.</p>\n"
msgstr ""
"<b>Port</b>\n"
"<p>\n"
"CUPS xezmätenä tıñlísı portnıñ sanın bilgeläw. Äytelmäsä, ul 631 dip sanala.</p>"
"\n"

#: cupsd.conf.template.cpp:716
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<b>Address</b>\n"
"<p>\n"
"The address that the CUPS daemon is listening at. Leave it empty or use\n"
"an asterisk (*) to specify a port value on the entire subnetwork.</p>\n"
msgstr ""
"<b>Adres</b>\n"
"<p>\n"
"CUPS xezmätenä tıñlísı adres bilgeläw. Äytelmäsä, ul 631 dip sanala.</p>\n"
"The address that the CUPS daemon is listening at. Eççeltärne tulayım bilgeläw "
"öçen, yä buş qaldırası, yä yoldız (*) bilgesen kertäse.</p>\n"

#: cupsd.conf.template.cpp:722
msgid ""
"_: Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)\n"
"<p>Check this box if you want to use SSL encryption with this address/port.\n"
"</p>\n"
msgstr ""
"<p>Bu köylämä saylanğan ikän, biredäge adres/port öçen SSL-serläw "
"qullanılır.</p>\n"


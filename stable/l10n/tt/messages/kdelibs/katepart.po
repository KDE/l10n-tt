#: part/kateprinter.cpp:788
msgid "<p>Format of the page header. The following tags are supported:</p>"
msgstr "<p>Bit başlığınıñ tözeleşe. Kiläse qırlarnı qullanıp bula:</p>"

#: part/kateprinter.cpp:790
msgid ""
"<ul>"
"<li><tt>%u</tt>: current user name</li>"
"<li><tt>%d</tt>: complete date/time in short format</li>"
"<li><tt>%D</tt>: complete date/time in long format</li>"
"<li><tt>%h</tt>: current time</li>"
"<li><tt>%y</tt>: current date in short format</li>"
"<li><tt>%Y</tt>: current date in long format</li>"
"<li><tt>%f</tt>: file name</li>"
"<li><tt>%U</tt>: full URL of the document</li>"
"<li><tt>%p</tt>: page number</li></ul>"
"<br><u>Note:</u> Do <b>not</b> use the '|' (vertical bar) character."
msgstr ""
"<ul>"
"<li><tt>%u</tt>: qullanuçı adı</li>"
"<li><tt>%d</tt>: waqıt/zaman, qısqa itep</li>"
"<li><tt>%D</tt>: waqıt/zaman, ozın itep</li>"
"<li><tt>%h</tt>: ağımdağı waqıt</li>"
"<li><tt>%y</tt>: ağımdağı zaman, qısqa itep</li>"
"<li><tt>%Y</tt>: ağımdağı zaman, ozın itep</li>"
"<li><tt>%f</tt>: birem adı</li>"
"<li><tt>%U</tt>: bu istälekneñ tulı URL'lı</li>"
"<li><tt>%p</tt>: bitneñ sanı</li></ul>"
"<br><u>Beläse:</u> '|' (asma tayaq) bilgesen qullanası <b>tügel</b>."

#: part/kateprinter.cpp:804
msgid "<p>Format of the page footer. The following tags are supported:</p>"
msgstr "<p>Bit astlığınıñ tözeleşe. Kiläse qırlarnı qullanıp bula:</p>"


msgstr "Disk Bireme Beterelde"

#: part/katedialogs.cpp:1580
msgid "&Save File As..."
msgstr "B&aşqaça Saqlaw..."

#: part/katedialogs.cpp:1581
msgid "Lets you select a location and save the file again."
msgstr "Berär urınlaşunı saylap, bu biremne qabat saqlarğa birä."


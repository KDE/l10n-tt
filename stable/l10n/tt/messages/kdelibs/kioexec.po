#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Eşlätü - Çittäge biremnär aça, üzgärülärne sizä, yöklärgä sorí"

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr "URL'dan cirle birem yasí da, soñraq anı beterep quya"

#: main.cpp:55
msgid "Suggested file name for the downloaded file"
msgstr ""

#: main.cpp:56
msgid "Command to execute"
msgstr "Eşlätäse boyırıq"

#: main.cpp:57
msgid "URL(s) or local file(s) used for 'command'"
msgstr "'command' belän qullanası cirle birem(när)/URL(lar)"

#: main.cpp:73
msgid ""
"'command' expected.\n"
msgstr ""
"'command' kötelde.\n"

#: main.cpp:102
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"Bu %1 URLı\n"
"yaraqsız"

#: main.cpp:104
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"--tempfiles açqıçı belän bergä\n"
"çittäge %1 URLın qullanıp bulmí"

#: main.cpp:237
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Waqıtlı %1\n"
"bireme üzgärtelgän bulğan axrısı.\n"
"Anı barıber beteräseme?"

#: main.cpp:238 main.cpp:245
msgid "File Changed"
msgstr "Birem Üzgärtelde"

#: main.cpp:238
msgid "Do Not Delete"
msgstr "Betermäskä"

#: main.cpp:244
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Bu %1\n"
"bireme üzgärtelgän bulğan axrısı.\n"
"Üzgärelgänen yökliseme?"

#: main.cpp:245
msgid "Upload"
msgstr "Yökläw"

#: main.cpp:245
msgid "Do Not Upload"
msgstr "Yöklämäskä"


#. i18n: file ./kdeui/kspellui.ui line 99
#: rc.cpp:128 rc.cpp:346
#, no-c-format
msgid ""
"<qt>\n"
"<p>Here you can see a text excerpt showing the unknown word in its context. If "
"this information is not sufficient to choose the best replacement for the "
"unknown word, you can click on the document you are proofing, read a larger "
"part of the text and then return here to continue proofing.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>Bilgesez süz oçrağan yazma kisäge bu cirdä kürsätelä. Bu belem şul bilgesez "
"süz turında tulayım beleşergä birmi ikän, istälekkä çirtep, annan uqıp alıp, "
"tözätü eşen dawam itep bula.</p>\n"
"</qt>"


msgstr "%1 protokolında totaşılunı yabu totılmí."

#: kio/global.cpp:426
#, c-format
msgid "Accessing files is not supported with the protocol %1."
msgstr "%1 protokolı aşa biremnärgä ireşü totılmí."

#: kio/global.cpp:428
msgid "Writing to %1 is not supported."
msgstr "%1 eçenä yazdıru totılmí."

#: kio/global.cpp:430
#, c-format

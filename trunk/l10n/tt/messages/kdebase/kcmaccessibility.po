#. i18n: file accessibilityconfigwidget.ui line 46
#: rc.cpp:9 rc.cpp:152
#, no-c-format
msgid "&Audible Bell"
msgstr "&Tawışlı Zil"

#. i18n: file accessibilityconfigwidget.ui line 50
#: rc.cpp:12 rc.cpp:155
#, no-c-format
msgid ""
"This is the configuration of the Audible Bell."
"<br>\n"
"It could be the system bell and/or a custom bell."
msgstr ""
"Tawışlı Belderü caylawı bu."
"<br>\n"
"Aña sistem zile belän/yä üzençä tawış köyläp bula."

#. i18n: file accessibilityconfigwidget.ui line 61
#: rc.cpp:16 rc.cpp:159
#, no-c-format
msgid "Use &system bell"
msgstr "&Sistem zilen qullanası"

#. i18n: file accessibilityconfigwidget.ui line 65
#: rc.cpp:19 rc.cpp:162
#, no-c-format
msgid ""
"If this option is checked, the default system bell will be used. See the "
"\"System Bell\" control module for how to customize the system bell."
"<br>\n"
"Normally, this is just a \"beep\"."
msgstr ""
"Bu köylämä yanıq torsa, sistemneñ töpcay zile qullanılaçaq. Sistem zilen köyläw "
"öçen \"Sistem Zile\" digän caylaw modulın qullanası."
"<br>\n"
"Töpcay bulıp, ul \"bip\" kileş kenä."

#. i18n: file accessibilityconfigwidget.ui line 73
#: rc.cpp:23 rc.cpp:166
#, no-c-format
msgid "Use &customized bell"
msgstr "Ü&zençä zil qullanası"

#. i18n: file accessibilityconfigwidget.ui line 77
#: rc.cpp:26 rc.cpp:169
#, no-c-format
msgid ""
"Check this option if you want to use a customized bell, playing a sound file. "
"If you do this, you will probably want to turn off the system bell."
"<br>\n"
"Please note that on slow machines this may cause a \"lag\" between the event "
"causing the bell and the sound being played."
msgstr ""
"Bu köylämä yanıq ikän, zil öçen üzençä tawış biremen saylap bula. Sistem tawışı "
"ul çaqta sünderelsä, yaqşıraq."
"<br>\n"
"Bonı beläse: sanaq ärken bulsa, waqığa çığudan soñ täwış çığuına tikle olı ara "
"bulıp çığuı bar."

#. i18n: file accessibilityconfigwidget.ui line 113
#: rc.cpp:30 rc.cpp:173
#, no-c-format
msgid "Sound &to play:"
msgstr "Uynatası &tawış:"

#. i18n: file accessibilityconfigwidget.ui line 119
#: rc.cpp:33 rc.cpp:176
#, no-c-format
msgid ""
"If the option \"Use customized bell\" is enabled, you can choose a sound file "
"here."
msgstr ""
"\"Üzençä zil qullanası\" digän köylämä yanıq torsa, bonda tawış biremen saylap "
"bula."


msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# KDE, %1 yasağan\n"
"#\n"
"# KDE sineñ GTK caylawların almaştıruın teläsäñ,\n"
"# İdärä Bülmäsendäge \"Küreneş & Tışlaw\" eçendäge \"Töslär\" saylap,\n"
"# \"KDE-bulmağan yazılımnarda töslärne aşırası\" tamğaqırın sünder.\n"
"#\n"
"#\n"

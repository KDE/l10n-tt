#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"KDE sessilärne ışanıçlı idäräçe bu.\n"
"XSMP protokolı aşa aralaşıp X11R6 sessilärne idärä itä ul."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Qullanuçı saqğan bulğan sessisen torğıza"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Täräzä idäräçeseneñ başqa törlese bu sessidä\n"
"qatnaşmağan çaqta 'wm' cibäreler. Gädättä isä 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections"
msgstr "Şulay uq çittän totaşırlıq it"

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "KDE Sessi İdäräse"

#: main.cpp:186
msgid "Maintainer"
msgstr "Bulışuçı"

#: shutdowndlg.cpp:99
msgid "End Session for \"%1\""
msgstr "\"%1\" öçen Sessine Yabu"

#: shutdowndlg.cpp:125
msgid "&End Current Session"
msgstr "Bu Sessine Ya&p"

#: shutdowndlg.cpp:133
msgid "&Turn Off Computer"
msgstr "&Sünder Sanaqnı"

#: shutdowndlg.cpp:141
msgid "&Restart Computer"
msgstr "&Sanaqnı Yañadan Yöklä"


msgid "Enable &networked sound"
msgstr "&Çeltärle tawış açası"

#. i18n: file generaltab.ui line 86
#: rc.cpp:19
#, no-c-format
msgid ""
"This option allows sound requests coming in from over the network to be "
"accepted, instead of just limiting the server to the local computer."
msgstr ""
"Tawış servere cirle sanaq öçen genä eşläw belän çiklänmiçä, çeltär aşa kilgän "
"sorawlarnı da eşkärtä alırlıq itä."

#. i18n: file generaltab.ui line 96
#: rc.cpp:22
#, no-c-format
msgid "Skip Prevention"
msgstr "Aldan Ütü"

#. i18n: file generaltab.ui line 107
#: rc.cpp:25
#, no-c-format
msgid ""
"<i>If your sound is skipping during playback, enable running with highest "
"possible priority. Increasing your sound buffer might also help.</i>"
msgstr ""
"<i>Tawış uynatqanda ütkän urınnarı işetelgän çaqta yuğarıraq östenlek birep "
"qararğa bula. Tawış öçen birelgän eşxäter külämen arttıru da ul çaqta bulışa "
"ala.</i>"

#. i18n: file generaltab.ui line 115
#: rc.cpp:28
#, no-c-format
msgid "&Run with the highest possible priority (realtime priority)"
msgstr "İñ yuğarı bulğan östenlek belän &cibäräse (çınçaq östenlege)"

#. i18n: file generaltab.ui line 121
#: rc.cpp:31
#, no-c-format

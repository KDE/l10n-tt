#: kio_mac.cpp:94
msgid "Unknown mode"
msgstr "Bilgesez ısul"

#: kio_mac.cpp:115
msgid "There was an error with hpcopy - please ensure it is installed"
msgstr "hpcopy eşlätkändä xata kilep çıqtı - anıñ quyılğan buluın tikşeräse"

#: kio_mac.cpp:131
msgid "No filename was found"
msgstr "Birem adı tabılmadı"

#: kio_mac.cpp:144
msgid "There was an error with hpls - please ensure it is installed"
msgstr "hpls eşlätkändä xata kilep çıqtı - anıñ quyılğan buluın tikşeräse"

#: kio_mac.cpp:187
msgid "No filename was found in the URL"
msgstr "Bu URL eçendä birem adı tabılmadı"

#: kio_mac.cpp:201
msgid "hpls did not exit normally - please ensure you have installed the hfsplus tools"
msgstr "hpls tieşleçä çıqmadı - hfsplus qorallarnıñ quyılğan buluın tikşerep alası"

#: kio_mac.cpp:288
msgid ""
"hpmount did not exit normally - please ensure that hfsplus utils are installed,\n"
"that you have permission to read the partition (ls -l /dev/hdaX)\n"
"and that you have specified the correct partition.\n"
"You can specify partitions by adding ?dev=/dev/hda2 to the URL."
msgstr ""
"hpmount tieşleçä çıqmadı - hfsplus qorallarnıñ quyılğan buluın tikşerep alası,\n"
"bu bülemne uqırlıq xoquqlarnıñ citüen (ls -l /dev/hdaX)\n"
"turı bülem äytelgän buluın.\n"
"Bülemnär URL'ğa bolay kertelä: ?dev=/dev/hda2."

#: kio_mac.cpp:320
msgid "hpcd did not exit normally - please ensure it is installed"
msgstr "hpcd tieşleçä çıqmadı - anıñ quyılğan buluın tikşerep alası"

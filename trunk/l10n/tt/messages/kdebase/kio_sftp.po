#: kio_sftp.cpp:427
msgid "An internal error occurred. Please retry the request again."
msgstr "Eçke xata oçradı. Bu sorawnı qabat cibärep qarísı."

#: kio_sftp.cpp:510
msgid "Opening SFTP connection to host <b>%1:%2</b>"
msgstr "Bu host belän SFTP-totaşu açu: <b>%1:%2</b>"

#: kio_sftp.cpp:514
msgid "No hostname specified"
msgstr "Host adı bilgelänmäde"

#: kio_sftp.cpp:526
msgid "SFTP Login"
msgstr "SFTP Kereşe"

#: kio_sftp.cpp:528
msgid "site:"
msgstr "säxifä:"

#: kio_sftp.cpp:629
msgid "Please enter your username and key passphrase."
msgstr "Qullanuçı adı belän açqıçqa sercömlä kertäse bar."

#: kio_sftp.cpp:631
msgid "Please enter your username and password."
msgstr "Üz atama belän sersüz saylísı:"

#: kio_sftp.cpp:639
msgid "Incorrect username or password"
msgstr "Qullanuçı adı/sersüze kileşmi"

#: kio_sftp.cpp:644
msgid "Please enter a username and password"
msgstr "Atama belän sersüz saylísı:"

#: kio_sftp.cpp:703
msgid "Warning: Cannot verify host's identity."
msgstr "Belderü: Host tanıtmasın tikşerä almím."

#: kio_sftp.cpp:714
msgid "Warning: Host's identity changed."
msgstr "Belderü: Host tanıtması üzgärelde."

#: kio_sftp.cpp:725 kio_sftp.cpp:726
msgid "Authentication failed."
msgstr "Tanılu uzmadı."

#: kio_sftp.cpp:740 kio_sftp.cpp:755
msgid "Connection failed."
msgstr "Totaşılıp bulmadı."

#: kio_sftp.cpp:741 ksshprocess.cpp:810 ksshprocess.cpp:957
msgid "Connection closed by remote host."
msgstr "Totaşu çit host yağınnan yabıldı."

#: kio_sftp.cpp:756
#, c-format
msgid "Unexpected SFTP error: %1"
msgstr "Kötelmägän SFTP-xata: %1"

#: kio_sftp.cpp:800
#, c-format
msgid "SFTP version %1"
msgstr "SFTP, %1 söreme "

#: kio_sftp.cpp:806
msgid "Protocol error."
msgstr "Protokol xatası."

#: kio_sftp.cpp:812
#, c-format
msgid "Successfully connected to %1"
msgstr "%1 belän totaşü uñıslı buldı"

#: kio_sftp.cpp:1047
msgid "An internal error occurred. Please try again."
msgstr "Eçke xata oçradı. Qabat qılıp qarísı."

#: kio_sftp.cpp:1068
msgid "Unknown error was encountered while copying the file to '%1'. Please try again."
msgstr "Biremne '%1' itep küplägändä xata kilep çıqtı. Tağın sınap qarísı."

#: kio_sftp.cpp:1318
msgid "The remote host does not support renaming files."
msgstr "Çittäge host birem adın üzgärtüen totmí."

#: kio_sftp.cpp:1367
msgid "The remote host does not support creating symbolic links."
msgstr "Çittäge host yomışaq bäylär yasawın totmí."

#: kio_sftp.cpp:1492
msgid "Connection closed"
msgstr "Totaşılu yabıldı"

#: kio_sftp.cpp:1494
msgid "Could not read SFTP packet"
msgstr "SFTP paket uqıp bulmadı"

#: kio_sftp.cpp:1611
msgid "SFTP command failed for an unknown reason."
msgstr "SFTP boyırağı bilgesez säbäp belän ütmäde."

#: kio_sftp.cpp:1615
msgid "The SFTP server received a bad message."
msgstr "SFTP-server bozıq belderü alğan."

#: kio_sftp.cpp:1619
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "Bu SFTP server totmağan eş eşlätep qarağanşıñ."

#: kio_sftp.cpp:1623
#, c-format
msgid "Error code: %1"
msgstr "Xata kodı: %1"

#: ksshprocess.cpp:408
msgid "Cannot specify a subsystem and command at the same time."
msgstr "Eçsistemne dä, boyırıqnı da beryulı  bilgeläp bulmí."

#: ksshprocess.cpp:743
msgid "No options provided for ssh execution."
msgstr "ssh eşlätü öçen köylämälär yuq."

#: ksshprocess.cpp:751
msgid "Failed to execute ssh process."
msgstr "ssh yazılımın eşlätep bulmadı."

#: ksshprocess.cpp:776 ksshprocess.cpp:805 ksshprocess.cpp:924
#: ksshprocess.cpp:996
msgid "Error encountered while talking to ssh."
msgstr "ssh belän aralaşqanda xata kilep çıqtı."

#: ksshprocess.cpp:856
msgid "Please supply a password."
msgstr "Sersüz kertäse bar."

#: ksshprocess.cpp:895
msgid "Please supply the passphrase for your SSH private key."
msgstr "Üz SSH açqıçına sercömlä kertäse."

#: ksshprocess.cpp:909
msgid "Authentication to %1 failed"
msgstr "%1 belän tanılu uzmadı"

#: ksshprocess.cpp:932
msgid "The identity of the remote host '%1' could not be verified because the host's key is not in the \"known hosts\" file."
msgstr "'%1' digän çit host tanıtmasın tikşerep bulmí, anıñ açqıçı \"tanış hostlar\" biremendä yuq."

#: ksshprocess.cpp:938
msgid " Manually, add the host's key to the \"known hosts\" file or contact your administrator."
msgstr " Bu host açqıçın \"bilgele host\" biremenä quldan kertäse, yä ki idäräçegä endäşäse."

#: ksshprocess.cpp:944
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr " Bu host açqıçın %1 eçenä quldan kertäse, yä ki idäräçegä endäşäse."

#: ksshprocess.cpp:976
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""
"'%1' digän çit host tanıtmasın tikşerep bulmí. Bu host açqıçınıñ tanıtması:\n"
"%2\n"
"Totaşu aldınnan bu host açqıçınıñ tanıtmasın anıñ idäräçedän sorísı bar.\n"
"\n"
"Bu host açqıcın alıp barıber totaşasımı? "

#: ksshprocess.cpp:1004
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may have just changed the host's key. Either way, you should verify the host's key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""
"BELDERÜ: '%1' host tanıtması üzgärelgän!\n"
"\n"
"Bu totaşuğa kemder qısılıp kerde, yä ki server idäräçe açqıçnı ürgärtkän. Niçek bulmasın, qabat totaşılu aldınnan bu host açqıçın anıñ idäräçe birgän açqıç tanıtması belän tikşerep alası bar.Biredäge açqıç tanıtması:\n"
"%2\n"
"Bu belderü bütän kürenmäsen öçen, ul açqıçnı \"%3\" eçenä östise."

#: ksshprocess.cpp:1039
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may have just changed the host's key. Either way, you should verify the host's key fingerprint with the host's administrator before connecting. The key fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""
"BELDERÜ: '%1' host tanıtması üzgärelgän!\n"
"\n"
"Bu totaşuğa kemder qısılıp kerde, yä ki server idäräçe açqıçnı ürgärtkän. Niçek bulmasın, qabat totaşılu aldınnan bu host açqıçın anıñ idäräçe birgän açqıç tanıtması belän tikşerep alası bar.Biredäge açqıç tanıtması:\n"
"%2\n"
"\n"
"Ul hostnıñ yaña açqıçın alıp barıber totaşılasımı?"

#: ksshprocess.cpp:1063
msgid "Host key was rejected."
msgstr "Host açqıçı kire qağıldı."
